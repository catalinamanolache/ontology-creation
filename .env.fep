# ============================================================
# FEP Environment Configuration — Ollama on GPU cluster
# ============================================================
# Copy this file to .env before running on FEP:
#   cp .env.fep .env
#
# NO API KEYS needed for local Ollama backend.
# The job script sets OLLAMA_BASE_URL and DATA_DIR automatically.
# ============================================================

# Use local Ollama (running on the same FEP compute node)
LLM_BACKEND=ollama

# Model to use — must be pulled on FEP first (see TUTORIAL_FEP.md)
# Recommended models for 8-24 GB VRAM:
#   qwen2.5:7b          (4.7 GB)  — fast, good quality
#   qwen2.5:14b         (9.0 GB)  — better quality
#   llama3.1:8b         (4.9 GB)  — alternative
#   mistral:7b          (4.1 GB)  — alternative
OLLAMA_MODEL=qwen2.5:14b

# Set by job.sh automatically based on SLURM_ARRAY_TASK_ID
# Override here only if running manually
OLLAMA_BASE_URL=http://127.0.0.1:11434

# No rate limiting for local Ollama
RATE_LIMIT_RPM=9999
RATE_LIMIT_RPD=999999
MIN_DELAY=0.0

# Chunking (adjust based on GPU memory and model context window)
CHUNK_SIZE=2500
CHUNK_OVERLAP=200

# API keys — intentionally empty (not needed for Ollama)
GOOGLE_API_KEY=
OPENAI_API_KEY=
HUGGINGFACE_API_KEY=
