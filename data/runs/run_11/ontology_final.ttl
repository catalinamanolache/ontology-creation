@prefix ex: <http://example.org/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# ===== OWL Classes =====
ex:AminoAcid rdf:type owl:Class ;
    rdfs:comment "Amino acids are the building blocks of proteins." .

ex:Protein rdf:type owl:Class ;
    rdfs:comment "Proteins are made up of amino acids." .

ex:ChemicalSubstance rdf:type owl:Class ;
    rdfs:comment "Amino acids are a class of chemicals." .

ex:Element rdf:type owl:Class ;
    rdfs:comment "Amino acids contain elements like carbon, hydrogen, oxygen, and nitrogen." .

ex:BiologicalProcess rdf:type owl:Class ;
    rdfs:comment "Amino acids regulate multiple processes associated with gene expression." .

ex:Disease rdf:type owl:Class ;
    rdfs:comment "Amino acid deficiency can lead to various diseases." .

ex:ChemicalReaction rdf:type owl:Class ;
    rdfs:comment "Amino acids undergo various chemical reactions." .

ex:PhysicalProperty rdf:type owl:Class ;
    rdfs:comment "Amino acids have physical properties like solubility and melting point." .

ex:OpticalProperty rdf:type owl:Class ;
    rdfs:comment "Amino acids exhibit optical properties." .

ex:Classification rdf:type owl:Class ;
    rdfs:comment "Amino acids can be classified based on their properties." .

ex:AliphaticAminoAcid rdf:type owl:Class ;
    rdfs:comment "Amino acids with aliphatic side chains." .

ex:HydroxylGroupContainingAminoAcid rdf:type owl:Class ;
    rdfs:comment "Amino acids with hydroxyl groups." .

ex:SulfurContainingAminoAcid rdf:type owl:Class ;
    rdfs:comment "Amino acids containing sulfur." .

ex:AcidicAminoAcid rdf:type owl:Class ;
    rdfs:comment "Amino acids with acidic properties." .

ex:BasicAminoAcid rdf:type owl:Class ;
    rdfs:comment "Amino acids with basic properties." .

ex:AromaticAminoAcid rdf:type owl:Class ;
    rdfs:comment "Amino acids with aromatic properties." .

ex:IminoAminoAcid rdf:type owl:Class ;
    rdfs:comment "Amino acids with imino groups." .

ex:HeterocyclicAminoAcid rdf:type owl:Class ;
    rdfs:comment "Amino acids with heterocyclic structures." .

ex:PurelyKetogenicAminoAcid rdf:type owl:Class ;
    rdfs:comment "Amino acids that are purely ketogenic." .

ex:KetogenicAndGlucogenicAminoAcid rdf:type owl:Class ;
    rdfs:comment "Amino acids that are both ketogenic and glucogenic." .

ex:PurelyGlucogenicAminoAcid rdf:type owl:Class ;
    rdfs:comment "Amino acids that are purely glucogenic." .

ex:NonPolarAminoAcid rdf:type owl:Class ;
    rdfs:comment "Amino acids with non-polar properties." .

ex:PolarAminoAcidWithNoCharge rdf:type owl:Class ;
    rdfs:comment "Amino acids with polar properties and no charge on the R group." .

ex:PolarAminoAcidWithPositiveCharge rdf:type owl:Class ;
    rdfs:comment "Amino acids with polar properties and a positive charge on the R group." .

ex:PolarAminoAcidWithNegativeCharge rdf:type owl:Class ;
    rdfs:comment "Amino acids with polar properties and a negative charge on the R group." .

ex:Hydroxyproline rdf:type owl:Class ;
    rdfs:comment "Hydroxyproline is required for the formation of collagen, the body's principal structural protein." .

ex:D-Penicillamine rdf:type owl:Class ;
    rdfs:comment "D-Penicillamine is a metabolite of penicillin and is employed in the chelation therapy of Wilson’s disease." .

ex:N-Acetylcysteine rdf:type owl:Class ;
    rdfs:comment "N-Acetylcysteine is used in cystic fibrosis and chronic renal insufficiency as an antioxidant." .

ex:Gabapentin rdf:type owl:Class ;
    rdfs:comment "Gabapentin is used as an anticonvulsant." .

# ===== Properties =====
ex:hasComposition rdf:type owl:ObjectProperty ;
    rdfs:domain ex:ChemicalSubstance ;
    rdfs:range ex:Element ;
    rdfs:comment "Chemical substances are composed of elements." .

ex:isComponentOf rdf:type owl:ObjectProperty ;
    rdfs:domain ex:Protein ;
    rdfs:range ex:AminoAcid ;
    rdfs:comment "Proteins are made up of amino acids." .

ex:regulates rdf:type owl:ObjectProperty ;
    rdfs:domain ex:BiologicalProcess ;
    rdfs:range ex:AminoAcid ;
    rdfs:comment "Amino acids regulate biological processes." .

ex:causes rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range ex:Disease ;
    rdfs:comment "Amino acid deficiency can cause diseases." .

ex:undergoes rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range ex:ChemicalReaction ;
    rdfs:comment "Amino acids undergo chemical reactions." .

ex:hasPhysicalProperty rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range ex:PhysicalProperty ;
    rdfs:comment "Amino acids have physical properties." .

ex:hasOpticalProperty rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range ex:OpticalProperty ;
    rdfs:comment "Amino acids have optical properties." .

ex:classifies rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range ex:Classification ;
    rdfs:comment "Amino acids can be classified." .

ex:classifiesAsAliphaticAminoAcid rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range ex:AliphaticAminoAcid ;
    rdfs:comment "Classifies an amino acid as aliphatic." .

ex:classifiesAsHydroxylGroupContainingAminoAcid rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range ex:HydroxylGroupContainingAminoAcid ;
    rdfs:comment "Classifies an amino acid as containing a hydroxyl group." .

ex:classifiesAsSulfurContainingAminoAcid rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range ex:SulfurContainingAminoAcid ;
    rdfs:comment "Classifies an amino acid as containing sulfur." .

ex:classifiesAsAcidicAminoAcid rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range ex:AcidicAminoAcid ;
    rdfs:comment "Classifies an amino acid as acidic." .

ex:classifiesAsBasicAminoAcid rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range ex:BasicAminoAcid ;
    rdfs:comment "Classifies an amino acid as basic." .

ex:classifiesAsAromaticAminoAcid rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range ex:AromaticAminoAcid ;
    rdfs:comment "Classifies an amino acid as aromatic." .

ex:classifiesAsIminoAminoAcid rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range ex:IminoAminoAcid ;
    rdfs:comment "Classifies an amino acid as imino." .

ex:classifiesAsHeterocyclicAminoAcid rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range ex:HeterocyclicAminoAcid ;
    rdfs:comment "Classifies an amino acid as heterocyclic." .

ex:classifiesAsPurelyKetogenicAminoAcid rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range ex:PurelyKetogenicAminoAcid ;
    rdfs:comment "Classifies an amino acid as purely ketogenic." .

ex:classifiesAsKetogenicAndGlucogenicAminoAcid rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range ex:KetogenicAndGlucogenicAminoAcid ;
    rdfs:comment "Classifies an amino acid as both ketogenic and glucogenic." .

ex:classifiesAsPurelyGlucogenicAminoAcid rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range ex:PurelyGlucogenicAminoAcid ;
    rdfs:comment "Classifies an amino acid as purely glucogenic." .

ex:classifiesAsNonPolarAminoAcid rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range ex:NonPolarAminoAcid ;
    rdfs:comment "Classifies an amino acid as non-polar." .

ex:classifiesAsPolarAminoAcidWithNoCharge rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range ex:PolarAminoAcidWithNoCharge ;
    rdfs:comment "Classifies an amino acid as polar with no charge on the R group." .

ex:classifiesAsPolarAminoAcidWithPositiveCharge rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range ex:PolarAminoAcidWithPositiveCharge ;
    rdfs:comment "Classifies an amino acid as polar with a positive charge on the R group." .

ex:classifiesAsPolarAminoAcidWithNegativeCharge rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range ex:PolarAminoAcidWithNegativeCharge ;
    rdfs:comment "Classifies an amino acid as polar with a negative charge on the R group." .

ex:isProducedByHydrolysis rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range ex:AminoAcid ;
    rdfs:comment "The amino acid is produced by hydrolysis." .

ex:isProducedByReaction rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range ex:ChemicalReaction ;
    rdfs:comment "The amino acid is produced by a specific chemical reaction." .

ex:isUsedFor rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range ex:Disease ;
    rdfs:comment "The amino acid is used to treat or prevent a specific disease." .

ex:isUsedIn rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range ex:Drug ;
    rdfs:comment "The amino acid is used as a drug." .

# ===== Instances =====
# ===== Relations =====
