@prefix ex: <http://example.org/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# ===== OWL Classes =====
ex:AminoAcid rdf:type owl:Class ;
    rdfs:comment "Amino acid, any of a group of organic molecules that contain a basic amino group (NH2) and an acidic carboxyl group (COOH)." .

ex:Protein rdf:type owl:Class ;
    rdfs:comment "Protein is made up of amino acids, which are the building blocks of the molecule." .

ex:ChemicalSubstance rdf:type owl:Class ;
    rdfs:comment "A general class for chemical substances." .

ex:Element rdf:type owl:Class ;
    rdfs:comment "Element, a fundamental substance in chemistry." .

ex:BiologicalProcess rdf:type owl:Class ;
    rdfs:comment "A process related to biological functions." .

ex:Disease rdf:type owl:Class ;
    rdfs:comment "A condition that impairs the normal functioning of an organism." .

ex:ChemicalReaction rdf:type owl:Class ;
    rdfs:comment "A process where one or more substances are transformed into one or more new substances." .

ex:PhysicalProperty rdf:type owl:Class ;
    rdfs:comment "A property that can be observed without changing the chemical identity of a substance." .

ex:OpticalProperty rdf:type owl:Class ;
    rdfs:comment "A property related to the interaction of light with a substance." .

ex:Classification rdf:type owl:Class ;
    rdfs:comment "A method of categorizing or organizing things into groups." .

ex:AliphaticAminoAcid rdf:type owl:Class ;
    rdfs:comment "Amino acids with aliphatic side chains." .

ex:HydroxylGroupContainingAminoAcid rdf:type owl:Class ;
    rdfs:comment "Amino acids with hydroxyl groups." .

ex:SulfurContainingAminoAcid rdf:type owl:Class ;
    rdfs:comment "Amino acids containing sulfur." .

ex:AcidicAminoAcid rdf:type owl:Class ;
    rdfs:comment "Amino acids with acidic properties." .

ex:BasicAminoAcid rdf:type owl:Class ;
    rdfs:comment "Amino acids with basic properties." .

ex:AromaticAminoAcid rdf:type owl:Class ;
    rdfs:comment "Amino acids with aromatic properties." .

ex:IminoAminoAcid rdf:type owl:Class ;
    rdfs:comment "Amino acids with imino groups." .

ex:HeterocyclicAminoAcid rdf:type owl:Class ;
    rdfs:comment "Amino acids with heterocyclic structures." .

ex:AlphaAminoAcid rdf:type owl:Class ;
    rdfs:comment "Amino acids with the amino group attached to the next carbon of the carboxyl group." .

ex:BetaAminoAcid rdf:type owl:Class ;
    rdfs:comment "Amino acids with the amino group attached to the third carbon of the carboxyl group." .

ex:GammaAminoAcid rdf:type owl:Class ;
    rdfs:comment "Amino acids with the amino group attached to the fourth carbon of the carboxyl group." .

ex:PurelyKetogenicAminoAcid rdf:type owl:Class ;
    rdfs:comment "Amino acids that can be used to make fat." .

ex:KetogenicAndGlucogenicAminoAcid rdf:type owl:Class ;
    rdfs:comment "Amino acids that can be metabolized into both ketogenic and glucogenic pathways." .

ex:PurelyGlucogenicAminoAcid rdf:type owl:Class ;
    rdfs:comment "Amino acids that can be used as a starting point for the production of glucose or glycogen." .

ex:NonPolarAminoAcid rdf:type owl:Class ;
    rdfs:comment "Amino acids with no charge on the 'R' group." .

ex:PolarAminoAcidWithNoCharge rdf:type owl:Class ;
    rdfs:comment "Amino acids with uncharged 'R' groups." .

ex:PolarAminoAcidWithPositiveCharge rdf:type owl:Class ;
    rdfs:comment "Amino acids with positive 'R' groups." .

ex:PolarAminoAcidWithNegativeCharge rdf:type owl:Class ;
    rdfs:comment "Amino acids with negative 'R' groups." .

ex:EssentialAminoAcid rdf:type owl:Class ;
    rdfs:comment "Amino acids that are not synthesized in the human body and must be obtained from food." .

ex:NonEssentialAminoAcid rdf:type owl:Class ;
    rdfs:comment "Amino acids that can be synthesized in the human body." .

ex:SemiEssentialAminoAcid rdf:type owl:Class ;
    rdfs:comment "Amino acids that are required in the diet of growing children but not for mature individuals." .

ex:Cysteine rdf:type owl:Class ;
    rdfs:comment "Cysteine is used in medicine to boost the efficiency of corticosteroid medications." .

ex:Cystine rdf:type owl:Class ;
    rdfs:comment "L-Cystine can be used in the treatment of surgery and trauma." .

ex:Tyrosine rdf:type owl:Class ;
    rdfs:comment "Tyrosine is commonly used in the production of thyroid hormone." .

ex:Threonine rdf:type owl:Class ;
    rdfs:comment "Threonine is used to treat spinal spasticity, multiple sclerosis, familial spastic paraparesis, and amyotrophic lateral sclerosis." .

ex:Proline rdf:type owl:Class ;
    rdfs:comment "L-proline supplements are used to improve joint and skin health." .

ex:Hydroxyproline rdf:type owl:Class ;
    rdfs:comment "Hydroxyproline is required for the formation of collagen, the body's principal structural protein." .

ex:AsparticAcid rdf:type owl:Class ;
    rdfs:comment "Aspartic acid is occasionally used to treat stress and exhaustion." .

ex:Asparagine rdf:type owl:Class ;
    rdfs:comment "Asparagine is necessary for brain development and function." .

ex:GlutamicAcid rdf:type owl:Class ;
    rdfs:comment "Glutamic acid serves as a source of energy for the brain." .

ex:BetaHydroxyGlutamicAcid rdf:type owl:Class ;
    rdfs:comment "Beta-hydroxy glutamic acid is used to treat acne, photoaging, dry skin, psoriasis, and melasma." .

ex:Glutamine rdf:type owl:Class ;
    rdfs:comment "Glutamine is used to keep blood sugar levels under control and consistent." .

ex:Ornithine rdf:type owl:Class ;
    rdfs:comment "L-ornithine is primarily used in health supplements to support sports and performance." .

ex:Arginine rdf:type owl:Class ;
    rdfs:comment "L-arginine is a non-essential amino acid that may play an important role in the treatment of cardiovascular disease." .

ex:Lysine rdf:type owl:Class ;
    rdfs:comment "Lysine appears to minimize cold sores when taken orally and when applied to the skin as a cream." .

ex:Histidine rdf:type owl:Class ;
    rdfs:comment "Histidine is used to treat anemia and can reduce blood pressure." .

ex:DPenicillamine rdf:type owl:Class ;
    rdfs:comment "D-Penicillamine is used in the chelation therapy of Wilson’s disease." .

ex:NAcetylcysteine rdf:type owl:Class ;
    rdfs:comment "N-Acetylcysteine is used in cystic fibrosis and chronic renal insufficiency as an antioxidant." .

ex:Gabapentin rdf:type owl:Class ;
    rdfs:comment "Gabapentin is used as an anticonvulsant." .

# ===== Properties =====
ex:hasComposition rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range ex:ChemicalSubstance ;
    rdfs:comment "Describes the composition of an amino acid." .

ex:isMadeOf rdf:type owl:ObjectProperty ;
    rdfs:domain ex:Protein ;
    rdfs:range ex:AminoAcid ;
    rdfs:comment "Describes the relationship between a protein and its amino acid components." .

ex:requiresDiet rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range ex:Element ;
    rdfs:comment "Describes the dietary requirement of amino acids." .

ex:hasFunction rdf:type owl:ObjectProperty ;
    rdfs:domain ex:BiologicalProcess ;
    rdfs:range ex:AminoAcid ;
    rdfs:comment "Describes the function of amino acids in biological processes." .

ex:causes rdf:type owl:ObjectProperty ;
    rdfs:domain ex:Disease ;
    rdfs:range ex:AminoAcid ;
    rdfs:comment "Describes the relationship between a disease and amino acid deficiency." .

ex:undergoes rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range ex:ChemicalReaction ;
    rdfs:comment "Describes the chemical reactions that amino acids undergo." .

ex:hasPhysicalProperty rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range ex:PhysicalProperty ;
    rdfs:comment "Describes the physical properties of amino acids." .

ex:hasOpticalProperty rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range ex:OpticalProperty ;
    rdfs:comment "Describes the optical properties of amino acids." .

ex:isClassifiedAs rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range ex:Classification ;
    rdfs:comment "Describes the classification of amino acids." .

ex:isAliphatic rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range ex:AliphaticAminoAcid ;
    rdfs:comment "Indicates if the amino acid has aliphatic side chains." .

ex:containsHydroxylGroup rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range ex:HydroxylGroupContainingAminoAcid ;
    rdfs:comment "Indicates if the amino acid has hydroxyl groups." .

ex:containsSulfur rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range ex:SulfurContainingAminoAcid ;
    rdfs:comment "Indicates if the amino acid contains sulfur." .

ex:isAcidic rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range ex:AcidicAminoAcid ;
    rdfs:comment "Indicates if the amino acid has acidic properties." .

ex:isBasic rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range ex:BasicAminoAcid ;
    rdfs:comment "Indicates if the amino acid has basic properties." .

ex:isAromatic rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range ex:AromaticAminoAcid ;
    rdfs:comment "Indicates if the amino acid has aromatic properties." .

ex:isImino rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range ex:IminoAminoAcid ;
    rdfs:comment "Indicates if the amino acid has imino groups." .

ex:isHeterocyclic rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range ex:HeterocyclicAminoAcid ;
    rdfs:comment "Indicates if the amino acid has heterocyclic structures." .

ex:isAlpha rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range ex:AlphaAminoAcid ;
    rdfs:comment "Indicates if the amino acid has the amino group attached to the next carbon of the carboxyl group." .

ex:isBeta rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range ex:BetaAminoAcid ;
    rdfs:comment "Indicates if the amino acid has the amino group attached to the third carbon of the carboxyl group." .

ex:isGamma rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range ex:GammaAminoAcid ;
    rdfs:comment "Indicates if the amino acid has the amino group attached to the fourth carbon of the carboxyl group." .

ex:isPurelyKetogenic rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range ex:PurelyKetogenicAminoAcid ;
    rdfs:comment "Indicates if the amino acid can be used to make fat." .

ex:isKetogenicAndGlucogenic rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range ex:KetogenicAndGlucogenicAminoAcid ;
    rdfs:comment "Indicates if the amino acid can be metabolized into both ketogenic and glucogenic pathways." .

ex:isPurelyGlucogenic rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range ex:PurelyGlucogenicAminoAcid ;
    rdfs:comment "Indicates if the amino acid can be used as a starting point for the production of glucose or glycogen." .

ex:isNonPolar rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range ex:NonPolarAminoAcid ;
    rdfs:comment "Indicates if the amino acid has no charge on the 'R' group." .

ex:isPolarWithNoCharge rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range ex:PolarAminoAcidWithNoCharge ;
    rdfs:comment "Indicates if the amino acid has uncharged 'R' groups." .

ex:isPolarWithPositiveCharge rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range ex:PolarAminoAcidWithPositiveCharge ;
    rdfs:comment "Indicates if the amino acid has positive 'R' groups." .

ex:isPolarWithNegativeCharge rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range ex:PolarAminoAcidWithNegativeCharge ;
    rdfs:comment "Indicates if the amino acid has negative 'R' groups." .

ex:isEssential rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range ex:EssentialAminoAcid ;
    rdfs:comment "Indicates if the amino acid is essential and must be obtained from food." .

ex:isNonEssential rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range ex:NonEssentialAminoAcid ;
    rdfs:comment "Indicates if the amino acid can be synthesized in the human body." .

ex:isSemiEssential rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range ex:SemiEssentialAminoAcid ;
    rdfs:comment "Indicates if the amino acid is required in the diet of growing children but not for mature individuals." .

# ===== Instances =====
# ===== Relations =====
