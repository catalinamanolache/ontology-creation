@prefix ex: <http://example.org/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# ===== OWL Classes =====
ex:AminoAcid rdf:type owl:Class ;
    rdfs:comment "A general class representing amino acids." .

ex:EssentialAminoAcid rdf:type owl:Class ;
    rdfs:comment "A specific type of amino acid that is essential for the body and must be obtained through food." .

ex:SemiEssentialAminoAcid rdf:type owl:Class ;
    rdfs:comment "A specific type of amino acid that can be produced in small amounts by the body but may need to be supplemented from food." .

ex:NonEssentialAminoAcid rdf:type owl:Class ;
    rdfs:comment "A specific type of amino acid that is not essential and can be synthesized by the body." .

ex:NonPolarAminoAcid rdf:type owl:Class ;
    rdfs:comment "A class representing non-polar (hydrophobic) amino acids that have no charge on the 'R' group." .

ex:PolarAminoAcidNoChargeRGroup rdf:type owl:Class ;
    rdfs:comment "A class representing polar amino acids with no charge on the 'R' group, which contribute to protein structure hydrogen bonding." .

ex:PolarAminoAcidPositiveRGroup rdf:type owl:Class ;
    rdfs:comment "A class representing polar amino acids with a positive 'R' group." .

ex:PolarAminoAcidNegativeRGroup rdf:type owl:Class ;
    rdfs:comment "A class representing polar amino acids with a negative 'R' group, which are aromatic dicarboxylic monoamino acids." .

ex:Tyrosine rdf:type owl:Class ;
    rdfs:comment "A specific type of amino acid that is involved in thyroid hormone production and has various other health benefits." .

ex:D-Penicillamine rdf:type owl:Class ;
    rdfs:comment "A non-standard amino acid used as a drug for chelation therapy, particularly in Wilson’s disease." .

ex:N-Acetylcysteine rdf:type owl:Class ;
    rdfs:comment "A non-standard amino acid used as an antioxidant and in the treatment of cystic fibrosis and chronic renal insufficiency." .

ex:Gabapentin rdf:type owl:Class ;
    rdfs:comment "A non-standard amino acid used as an anticonvulsant drug." .

# ===== Properties =====
ex:hasCanonicalName rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range xsd:string ;
    rdfs:comment "Maps an amino acid to its canonical name." .

ex:isEssential rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether the amino acid is essential for the body." .

ex:hasProperties rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range ex:AminoAcidProperty ;
    rdfs:comment "Links an amino acid to its properties." .

ex:isProducedByBody rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether the amino acid is produced by the body or needs to be obtained through food." .

ex:hasStructure rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range ex:MolecularStructure ;
    rdfs:comment "Describes the structure of an amino acid." .

ex:isDecarboxylatedTo rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range ex:AminoAcid ;
    rdfs:comment "Indicates the amino acid that results from decarboxylation of another amino acid." .

ex:reactsWithAlcohol rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether an amino acid can react with alcohol to form esters." .

ex:reactsWithAmmonia rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether an amino acid can react with ammonia to form amides." .

ex:reactsWithMineralAcids rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether an amino acid can react with mineral acids to form salts." .

ex:reactsWithNinhydrin rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether an amino acid reacts with ninhydrin to produce a color change." .

ex:isSemiEssential rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether the amino acid is semi-essential and requires supplementation from food." .

ex:isNonPolar rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether the amino acid is non-polar (hydrophobic) with no charge on the 'R' group." .

ex:isPolarNoChargeRGroup rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether the amino acid is polar with no charge on the 'R' group, contributing to protein structure hydrogen bonding." .

ex:isPolarPositiveRGroup rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether the amino acid is polar with a positive 'R' group." .

ex:isPolarNegativeRGroup rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether the amino acid is polar with a negative 'R' group, being aromatic dicarboxylic monoamino acids." .

ex:treatsCondition rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range xsd:string ;
    rdfs:comment "Indicates the conditions that can be treated by a specific amino acid." .

ex:isDrug rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether an amino acid is used as a drug." .

# ===== Instances =====
# ===== Relations =====
