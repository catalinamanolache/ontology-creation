@prefix ex: <http://example.org/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# ===== OWL Classes =====
ex:AminoAcid rdf:type owl:Class ;
    rdfs:comment "Amino acids are the building blocks of proteins." .

ex:Protein rdf:type owl:Class ;
    rdfs:comment "Proteins are made up of amino acids." .

ex:ChemicalSubstance rdf:type owl:Class ;
    rdfs:comment "Amino acids are a class of chemicals." .

ex:EssentialAminoAcid rdf:type owl:Class ;
    rdfs:comment "Amino acids that are not produced by the body and must be obtained through food." .

ex:NonEssentialAminoAcid rdf:type owl:Class ;
    rdfs:comment "Amino acids that are produced by the body and do not require supplementation." .

ex:SemiEssentialAminoAcid rdf:type owl:Class ;
    rdfs:comment "Amino acids that are produced in the body but in insufficient amounts." .

ex:Acid rdf:type owl:Class ;
    rdfs:comment "Amino acids can undergo reactions with alkalies to form salts." .

ex:Base rdf:type owl:Class ;
    rdfs:comment "Amino acids can undergo reactions with acids to form salts." .

ex:Zwitterion rdf:type owl:Class ;
    rdfs:comment "Amino acids can exist as zwitterions due to the presence of both positive and negative charges." .

ex:Ninhydrin rdf:type owl:Class ;
    rdfs:comment "A chemical used in reactions with amino acids to detect their presence." .

ex:AliphaticAminoAcid rdf:type owl:Class ;
    rdfs:comment "Amino acids with aliphatic side chains." .

ex:BetaAminoAcid rdf:type owl:Class ;
    rdfs:comment "Amino acids with the amino group attached to the third carbon of the carboxyl group." .

ex:GammaAminoAcid rdf:type owl:Class ;
    rdfs:comment "Amino acids with the amino group attached to the fourth carbon of the carboxyl group." .

ex:HydroxylGroupContainingAminoAcid rdf:type owl:Class ;
    rdfs:comment "Amino acids with hydroxyl groups." .

ex:IminoAminoAcid rdf:type owl:Class ;
    rdfs:comment "Amino acids with an imino group instead of an amino group." .

ex:HeterocyclicAminoAcid rdf:type owl:Class ;
    rdfs:comment "Amino acids with heterocyclic structures." .

ex:KetogenicAminoAcid rdf:type owl:Class ;
    rdfs:comment "Amino acids that can be used to make fat and are transformed into ketone bodies." .

ex:KetogenicAndGlucogenicAminoAcid rdf:type owl:Class ;
    rdfs:comment "Amino acids that can be metabolized into both ketogenic and glucogenic pathways." .

ex:PurelyGlucogenicAminoAcid rdf:type owl:Class ;
    rdfs:comment "Amino acids that can be used as a starting point for the production of glucose or glycogen." .

ex:NonPolarAminoAcid rdf:type owl:Class ;
    rdfs:comment "Amino acids with no charge on the 'R' group." .

ex:PolarAminoAcidWithNoCharge rdf:type owl:Class ;
    rdfs:comment "Amino acids with an uncharged 'R' group but with groups that contribute to hydrogen bonding." .

ex:PolarAminoAcidWithPositiveCharge rdf:type owl:Class ;
    rdfs:comment "Amino acids with a positive charge on the 'R' group." .

ex:PolarAminoAcidWithNegativeCharge rdf:type owl:Class ;
    rdfs:comment "Amino acids with a negative charge on the 'R' group." .

ex:SulphurContainingAminoAcid rdf:type owl:Class ;
    rdfs:comment "Amino acids with a sulfohydryl or thioether group." .

ex:Hydroxyproline rdf:type owl:Class ;
    rdfs:comment "Hydroxyproline is required for the formation of collagen, the body's principal structural protein." .

ex:BetaHydroxyGlutamicAcid rdf:type owl:Class ;
    rdfs:comment "Used to treat acne, photoaging, dry skin, psoriasis, and melasma, among other dermatological diseases." .

ex:DPenicillamine rdf:type owl:Class ;
    rdfs:comment "Used in the chelation therapy of Wilson’s disease." .

ex:NAcetylcysteine rdf:type owl:Class ;
    rdfs:comment "Used in cystic fibrosis, and chronic renal insufficiency, as it can function as an antioxidant." .

ex:Gabapentin rdf:type owl:Class ;
    rdfs:comment "Used as an anticonvulsant." .

# ===== Properties =====
ex:hasComposition rdf:type owl:ObjectProperty ;
    rdfs:domain ex:ChemicalSubstance ;
    rdfs:range ex:AminoAcid ;
    rdfs:comment "Amino acids are a component of chemical substances." .

ex:isEssential rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range ex:Boolean ;
    rdfs:comment "Indicates whether an amino acid is essential or not." .

ex:isNonEssential rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range ex:Boolean ;
    rdfs:comment "Indicates whether an amino acid is non-essential or not." .

ex:isSemiEssential rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range ex:Boolean ;
    rdfs:comment "Indicates whether an amino acid is semi-essential or not." .

ex:hasFunction rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range ex:Protein ;
    rdfs:comment "Amino acids have functions in the synthesis of proteins." .

ex:reactsWith rdf:type owl:ObjectProperty ;
    rdfs:domain ex:ChemicalSubstance ;
    rdfs:range ex:ChemicalSubstance ;
    rdfs:comment "Chemical substances can react with each other." .

ex:formsZwitterion rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range ex:Zwitterion ;
    rdfs:comment "Amino acids can form zwitterions." .

ex:formsSalt rdf:type owl:ObjectProperty ;
    rdfs:domain ex:ChemicalSubstance ;
    rdfs:range ex:ChemicalSubstance ;
    rdfs:comment "Chemical substances can form salts." .

ex:reactsWithNinhydrin rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range ex:ChemicalSubstance ;
    rdfs:comment "Amino acids can react with ninhydrin to form a color." .

ex:hasAliphaticSideChain rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range ex:Boolean ;
    rdfs:comment "Indicates whether an amino acid has an aliphatic side chain." .

ex:hasBetaPosition rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range ex:Boolean ;
    rdfs:comment "Indicates whether an amino acid has the amino group attached to the third carbon of the carboxyl group." .

ex:hasGammaPosition rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range ex:Boolean ;
    rdfs:comment "Indicates whether an amino acid has the amino group attached to the fourth carbon of the carboxyl group." .

ex:hasHydroxylGroup rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range ex:Boolean ;
    rdfs:comment "Indicates whether an amino acid has a hydroxyl group." .

ex:hasIminoGroup rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range ex:Boolean ;
    rdfs:comment "Indicates whether an amino acid has an imino group." .

ex:hasHeterocyclicStructure rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range ex:Boolean ;
    rdfs:comment "Indicates whether an amino acid has a heterocyclic structure." .

ex:isKetogenic rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range ex:Boolean ;
    rdfs:comment "Indicates whether an amino acid is ketogenic." .

ex:isKetogenicAndGlucogenic rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range ex:Boolean ;
    rdfs:comment "Indicates whether an amino acid is ketogenic and glucogenic." .

ex:isPurelyGlucogenic rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range ex:Boolean ;
    rdfs:comment "Indicates whether an amino acid is purely glucogenic." .

ex:isNonPolar rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range ex:Boolean ;
    rdfs:comment "Indicates whether an amino acid is non-polar." .

ex:isPolarWithNoCharge rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range ex:Boolean ;
    rdfs:comment "Indicates whether an amino acid is polar with no charge on the 'R' group." .

ex:isPolarWithPositiveCharge rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range ex:Boolean ;
    rdfs:comment "Indicates whether an amino acid is polar with a positive charge on the 'R' group." .

ex:isPolarWithNegativeCharge rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range ex:Boolean ;
    rdfs:comment "Indicates whether an amino acid is polar with a negative charge on the 'R' group." .

ex:isSulphurContaining rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range ex:Boolean ;
    rdfs:comment "Indicates whether an amino acid is sulphur containing." .

ex:isHydroxyproline rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range ex:Boolean ;
    rdfs:comment "Indicates whether an amino acid is hydroxyproline." .

ex:isBetaHydroxyGlutamicAcid rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range ex:Boolean ;
    rdfs:comment "Indicates whether an amino acid is beta-hydroxy glutamic acid." .

ex:isDPenicillamine rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range ex:Boolean ;
    rdfs:comment "Indicates whether an amino acid is D-penicillamine." .

ex:isNAcetylcysteine rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range ex:Boolean ;
    rdfs:comment "Indicates whether an amino acid is N-acetylcysteine." .

ex:isGabapentin rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range ex:Boolean ;
    rdfs:comment "Indicates whether an amino acid is gabapentin." .

# ===== Instances =====
# ===== Relations =====
