@prefix ex: <http://example.org/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix bfo: <http://purl.obolibrary.org/obo/BFO_> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# ===== OWL Classes (BFO-anchored) =====
ex:AminoAcid rdf:type owl:Class ;
    rdfs:subClassOf bfo:MaterialEntity ;
    skos:definition "An AminoAcid is a MaterialEntity that contains a basic amino group, an acidic carboxyl group, and an organic R group." ;
    rdfs:comment "An organic molecule that is a building block of proteins." .

ex:Protein rdf:type owl:Class ;
    rdfs:subClassOf bfo:MaterialEntity ;
    skos:definition "A Protein is a MaterialEntity that is a polymer composed of amino acid residues." ;
    rdfs:comment "A large biomolecule consisting of one or more long chains of amino acid residues." .

ex:EssentialAminoAcid rdf:type owl:Class ;
    rdfs:subClassOf bfo:MaterialEntity ;
    rdfs:subClassOf ex:AminoAcid ;
    skos:definition "An EssentialAminoAcid is an AminoAcid that cannot be synthesized by the body and must be obtained from the diet." ;
    rdfs:comment "An amino acid that must be supplied through the diet because the body cannot synthesize it." .

ex:NonEssentialAminoAcid rdf:type owl:Class ;
    rdfs:subClassOf bfo:MaterialEntity ;
    rdfs:subClassOf ex:AminoAcid ;
    skos:definition "A NonEssentialAminoAcid is an AminoAcid that can be synthesized by the body." ;
    rdfs:comment "An amino acid that the body can synthesize and does not need to be obtained from the diet." .

ex:SemiEssentialAminoAcid rdf:type owl:Class ;
    rdfs:subClassOf bfo:MaterialEntity ;
    rdfs:subClassOf ex:AminoAcid ;
    skos:definition "A SemiEssentialAminoAcid is an AminoAcid that can be synthesized by the body, but not in sufficient quantities." ;
    rdfs:comment "An amino acid that the body can synthesize, but may require dietary intake under certain conditions." .

ex:AminoGroup rdf:type owl:Class ;
    rdfs:subClassOf bfo:Quality ;
    skos:definition "An AminoGroup is a Quality that is a basic functional group containing a nitrogen atom bonded to hydrogen atoms or organic substituents." ;
    rdfs:comment "A functional group with the general formula -NH2, -NHR, or -NR2." .

ex:CarboxylGroup rdf:type owl:Class ;
    rdfs:subClassOf bfo:Quality ;
    skos:definition "A CarboxylGroup is a Quality that is an acidic functional group with the formula -COOH." ;
    rdfs:comment "A functional group consisting of a carbon atom double-bonded to an oxygen atom and single-bonded to a hydroxyl group." .

ex:RGroup rdf:type owl:Class ;
    rdfs:subClassOf bfo:Quality ;
    skos:definition "An RGroup is a Quality that is the unique side chain of an amino acid." ;
    rdfs:comment "The variable side chain of an amino acid that determines its specific properties." .

ex:BranchedChainAminoAcid rdf:type owl:Class ;
    rdfs:subClassOf bfo:MaterialEntity ;
    rdfs:subClassOf ex:AminoAcid ;
    skos:definition "A BranchedChainAminoAcid is an AminoAcid that has branched aliphatic side chains." ;
    rdfs:comment "Amino acids with branched aliphatic side chains, such as leucine, isoleucine, and valine." .

ex:HydroxylGroupContainingAminoAcid rdf:type owl:Class ;
    rdfs:subClassOf bfo:MaterialEntity ;
    rdfs:subClassOf ex:AminoAcid ;
    skos:definition "A HydroxylGroupContainingAminoAcid is an AminoAcid that possesses a hydroxyl group in its side chain." ;
    rdfs:comment "Amino acids that contain a hydroxyl group in their R group, including serine, threonine, and tyrosine." .

ex:SulfurContainingAminoAcid rdf:type owl:Class ;
    rdfs:subClassOf bfo:MaterialEntity ;
    rdfs:subClassOf ex:AminoAcid ;
    skos:definition "A SulfurContainingAminoAcid is an AminoAcid that contains sulfur in its side chain." ;
    rdfs:comment "Amino acids that have sulfur in their side chain, such as cysteine and methionine." .

ex:AcidicAminoAcid rdf:type owl:Class ;
    rdfs:subClassOf bfo:MaterialEntity ;
    rdfs:subClassOf ex:AminoAcid ;
    skos:definition "An AcidicAminoAcid is an AminoAcid that has a carboxyl group in its side chain, resulting in a negative charge at physiological pH." ;
    rdfs:comment "Amino acids with a carboxyl group in their side chain, such as aspartic acid and glutamic acid." .

ex:AmideAminoAcid rdf:type owl:Class ;
    rdfs:subClassOf bfo:MaterialEntity ;
    rdfs:subClassOf ex:AminoAcid ;
    skos:definition "An AmideAminoAcid is an AminoAcid that is an amide derivative of an acidic amino acid." ;
    rdfs:comment "Amide derivatives of acidic amino acids, such as asparagine and glutamine." .

ex:BasicAminoAcid rdf:type owl:Class ;
    rdfs:subClassOf bfo:MaterialEntity ;
    rdfs:subClassOf ex:AminoAcid ;
    skos:definition "A BasicAminoAcid is an AminoAcid that has a basic functional group (like guanidino or imidazole) in its side chain, resulting in a positive charge at physiological pH." ;
    rdfs:comment "Amino acids with a basic functional group in their side chain, such as lysine, arginine, and histidine." .

ex:AromaticAminoAcid rdf:type owl:Class ;
    rdfs:subClassOf bfo:MaterialEntity ;
    rdfs:subClassOf ex:AminoAcid ;
    skos:definition "An AromaticAminoAcid is an AminoAcid that contains an aromatic ring in its side chain." ;
    rdfs:comment "Amino acids containing an aromatic ring in their side chain, including phenylalanine, tyrosine, and tryptophan." .

ex:IminoAcid rdf:type owl:Class ;
    rdfs:subClassOf bfo:MaterialEntity ;
    rdfs:subClassOf ex:AminoAcid ;
    skos:definition "An IminoAcid is an AminoAcid where the amino group is part of a ring structure, specifically a pyrrolidine ring in the case of proline." ;
    rdfs:comment "An unusual amino acid, like proline, where the nitrogen atom is part of a ring structure." .

ex:HeterocyclicAminoAcid rdf:type owl:Class ;
    rdfs:subClassOf bfo:MaterialEntity ;
    rdfs:subClassOf ex:AminoAcid ;
    skos:definition "A HeterocyclicAminoAcid is an AminoAcid that contains a heterocyclic ring in its side chain." ;
    rdfs:comment "Amino acids containing a heterocyclic ring in their side chain, such as histidine, tryptophan, and proline." .

ex:AlphaAminoAcid rdf:type owl:Class ;
    rdfs:subClassOf bfo:MaterialEntity ;
    rdfs:subClassOf ex:AminoAcid ;
    skos:definition "An AlphaAminoAcid is an AminoAcid where the amino group is attached to the alpha carbon atom, which is adjacent to the carboxyl group." ;
    rdfs:comment "Amino acids in which the amino group is attached to the alpha carbon." .

ex:BetaAminoAcid rdf:type owl:Class ;
    rdfs:subClassOf bfo:MaterialEntity ;
    rdfs:subClassOf ex:AminoAcid ;
    skos:definition "A BetaAminoAcid is an AminoAcid where the amino group is attached to the beta carbon atom, which is two carbons away from the carboxyl group." ;
    rdfs:comment "Amino acids in which the amino group is attached to the beta carbon." .

ex:GammaAminoAcid rdf:type owl:Class ;
    rdfs:subClassOf bfo:MaterialEntity ;
    rdfs:subClassOf ex:AminoAcid ;
    skos:definition "A GammaAminoAcid is an AminoAcid where the amino group is attached to the gamma carbon atom, which is three carbons away from the carboxyl group." ;
    rdfs:comment "Amino acids in which the amino group is attached to the gamma carbon." .

ex:PurelyKetogenicAminoAcid rdf:type owl:Class ;
    rdfs:subClassOf bfo:MaterialEntity ;
    rdfs:subClassOf ex:AminoAcid ;
    skos:definition "A PurelyKetogenicAminoAcid is an AminoAcid that can only be metabolized into ketone bodies." ;
    rdfs:comment "Amino acids that can be converted solely into ketone bodies, such as leucine and lysine." .

ex:KetogenicAndGlucogenicAminoAcid rdf:type owl:Class ;
    rdfs:subClassOf bfo:MaterialEntity ;
    rdfs:subClassOf ex:AminoAcid ;
    skos:definition "A KetogenicAndGlucogenicAminoAcid is an AminoAcid that can be metabolized into both ketone bodies and glucose." ;
    rdfs:comment "Amino acids that can be metabolized into both ketone bodies and glucose, such as lysine, isoleucine, phenylalanine, tyrosine, and tryptophan." .

ex:PurelyGlucogenicAminoAcid rdf:type owl:Class ;
    rdfs:subClassOf bfo:MaterialEntity ;
    rdfs:subClassOf ex:AminoAcid ;
    skos:definition "A PurelyGlucogenicAminoAcid is an AminoAcid that can only be metabolized into glucose or glycogen." ;
    rdfs:comment "Amino acids that can be converted solely into glucose or glycogen." .

ex:HydrophobicAminoAcid rdf:type owl:Class ;
    rdfs:subClassOf bfo:MaterialEntity ;
    rdfs:subClassOf ex:AminoAcid ;
    skos:definition "A HydrophobicAminoAcid is an AminoAcid with a non-polar side chain that repels water." ;
    rdfs:comment "Amino acids with non-polar side chains that are water-repelling, also known as non-polar amino acids." .

ex:PolarUnchargedAminoAcid rdf:type owl:Class ;
    rdfs:subClassOf bfo:MaterialEntity ;
    rdfs:subClassOf ex:AminoAcid ;
    skos:definition "A PolarUnchargedAminoAcid is an AminoAcid with a polar side chain that does not carry a net charge at physiological pH." ;
    rdfs:comment "Amino acids with polar side chains that are uncharged at physiological pH, capable of hydrogen bonding." .

ex:PolarPositivelyChargedAminoAcid rdf:type owl:Class ;
    rdfs:subClassOf bfo:MaterialEntity ;
    rdfs:subClassOf ex:AminoAcid ;
    skos:definition "A PolarPositivelyChargedAminoAcid is an AminoAcid with a polar side chain that carries a net positive charge at physiological pH." ;
    rdfs:comment "Amino acids with polar side chains that carry a net positive charge at physiological pH." .

ex:PolarNegativelyChargedAminoAcid rdf:type owl:Class ;
    rdfs:subClassOf bfo:MaterialEntity ;
    rdfs:subClassOf ex:AminoAcid ;
    skos:definition "A PolarNegativelyChargedAminoAcid is an AminoAcid with a polar side chain that carries a net negative charge at physiological pH." ;
    rdfs:comment "Amino acids with polar side chains that carry a net negative charge at physiological pH." .

ex:Glycine rdf:type owl:Class ;
    rdfs:subClassOf bfo:MaterialEntity ;
    rdfs:subClassOf ex:AminoAcid ;
    skos:definition "A Glycine is an AminoAcid that is used to treat schizophrenia, sleep issues, BPH, metabolic syndrome, and inherited metabolic illnesses." ;
    rdfs:comment "Glycine is an amino acid used in medicine for various conditions." .

ex:Alanine rdf:type owl:Class ;
    rdfs:subClassOf bfo:MaterialEntity ;
    rdfs:subClassOf ex:AminoAcid ;
    skos:definition "An Alanine is an AminoAcid that is utilized to boost immunity and provide the brain and central nervous system more energy." ;
    rdfs:comment "Alanine is an amino acid that supports immunity and brain energy." .

ex:Valine rdf:type owl:Class ;
    rdfs:subClassOf bfo:MaterialEntity ;
    rdfs:subClassOf ex:BranchedChainAminoAcid ;
    skos:definition "A Valine is an AminoAcid that is involved in muscle synthesis and maintenance, stress management, child growth, and immune system support." ;
    rdfs:comment "Valine is a branched-chain amino acid important for muscle and immunity." .

ex:Leucine rdf:type owl:Class ;
    rdfs:subClassOf bfo:MaterialEntity ;
    rdfs:subClassOf ex:BranchedChainAminoAcid ;
    skos:definition "A Leucine is an AminoAcid that increases physical performance, prevents muscle loss, and lowers blood glucose levels in type 2 diabetes." ;
    rdfs:comment "Leucine is a branched-chain amino acid that enhances physical performance and regulates blood sugar." .

ex:Isoleucine rdf:type owl:Class ;
    rdfs:subClassOf bfo:MaterialEntity ;
    rdfs:subClassOf ex:BranchedChainAminoAcid ;
    skos:definition "An Isoleucine is an AminoAcid that is required for children's optimum growth and the maintenance of nitrogen balance in adults." ;
    rdfs:comment "Isoleucine is a branched-chain amino acid crucial for growth and nitrogen balance." .

ex:Norleucine rdf:type owl:Class ;
    rdfs:subClassOf bfo:MaterialEntity ;
    rdfs:subClassOf ex:AminoAcid ;
    skos:definition "A Norleucine is an AminoAcid that is an artificial amino acid used to research protein structure and function." ;
    rdfs:comment "Norleucine is a synthetic amino acid used in laboratory research." .

ex:Phenylalanine rdf:type owl:Class ;
    rdfs:subClassOf bfo:MaterialEntity ;
    rdfs:subClassOf ex:AromaticAminoAcid ;
    skos:definition "A Phenylalanine is an AminoAcid that is used to treat depression, Parkinson's illness, multiple sclerosis, pain, acupuncture anesthesia, and osteoarthritis." ;
    rdfs:comment "Phenylalanine is an aromatic amino acid used in treating neurological and pain conditions." .

ex:Tyrosine rdf:type owl:Class ;
    rdfs:subClassOf bfo:MaterialEntity ;
    rdfs:subClassOf ex:AromaticAminoAcid ;
    skos:definition "A Tyrosine is an AminoAcid that is utilized in the production of thyroid hormone and helps with mental performance, alertness, and memory." ;
    rdfs:comment "Tyrosine is an aromatic amino acid involved in thyroid hormone production and cognitive function." .

ex:Serine rdf:type owl:Class ;
    rdfs:subClassOf bfo:MaterialEntity ;
    rdfs:subClassOf ex:HydroxylGroupContainingAminoAcid ;
    skos:definition "A Serine is an AminoAcid that is particularly significant for the brain and central nervous system to function correctly." ;
    rdfs:comment "Serine is an amino acid essential for proper brain and central nervous system function." .

ex:Cysteine rdf:type owl:Class ;
    rdfs:subClassOf bfo:MaterialEntity ;
    rdfs:subClassOf ex:SulfurContainingAminoAcid ;
    skos:definition "A Cysteine is an AminoAcid that is used in medicine to boost the efficiency of corticosteroid medications." ;
    rdfs:comment "Cysteine is a sulfur-containing amino acid that enhances corticosteroid efficacy." .

ex:Cystine rdf:type owl:Class ;
    rdfs:subClassOf bfo:MaterialEntity ;
    rdfs:subClassOf ex:SulfurContainingAminoAcid ;
    skos:definition "A Cystine is an AminoAcid that can be used in the treatment of surgery and trauma." ;
    rdfs:comment "Cystine is a sulfur-containing amino acid used in post-surgical and trauma treatment." .

ex:Threonine rdf:type owl:Class ;
    rdfs:subClassOf bfo:MaterialEntity ;
    rdfs:subClassOf ex:AminoAcid ;
    skos:definition "A Threonine is an AminoAcid that is used to treat spinal spasticity, multiple sclerosis, familial spastic paraparesis, and amyotrophic lateral sclerosis." ;
    rdfs:comment "Threonine is an amino acid used in treating neurological conditions like spasticity and sclerosis." .

ex:Methionine rdf:type owl:Class ;
    rdfs:subClassOf bfo:MaterialEntity ;
    rdfs:subClassOf ex:SulfurContainingAminoAcid ;
    skos:definition "A Methionine is an AminoAcid that is used to prevent and cure depression, inflammation, liver illness, and muscle discomfort." ;
    rdfs:comment "Methionine is a sulfur-containing amino acid used for depression, inflammation, and liver health." .

ex:Tryptophan rdf:type owl:Class ;
    rdfs:subClassOf bfo:MaterialEntity ;
    rdfs:subClassOf ex:AminoAcid ;
    skos:definition "A Tryptophan is an AminoAcid that has been used to treat anxiety and depression, and is used to treat migraines, headaches, and boost growth hormone production." ;
    rdfs:comment "Tryptophan is an amino acid used for mood disorders, migraines, and growth hormone stimulation." .

ex:Proline rdf:type owl:Class ;
    rdfs:subClassOf bfo:MaterialEntity ;
    rdfs:subClassOf ex:IminoAcid ;
    skos:definition "A Proline is an AminoAcid that is used to improve joint and skin health, and may help with muscle development and injury healing." ;
    rdfs:comment "Proline is an imino acid beneficial for joint, skin, and muscle health." .

ex:Hydroxyproline rdf:type owl:Class ;
    rdfs:subClassOf bfo:MaterialEntity ;
    rdfs:subClassOf ex:IminoAcid ;
    skos:definition "A Hydroxyproline is an AminoAcid that is required for the formation of collagen, the body's principal structural protein." ;
    rdfs:comment "Hydroxyproline is an imino acid essential for collagen formation and structural integrity." .

ex:AsparticAcid rdf:type owl:Class ;
    rdfs:subClassOf bfo:MaterialEntity ;
    rdfs:subClassOf ex:AcidicAminoAcid ;
    skos:definition "An AsparticAcid is an AminoAcid that is occasionally used to treat stress and exhaustion, and aids in energy generation and RNA/DNA manufacturing." ;
    rdfs:comment "Aspartic Acid is an acidic amino acid involved in energy production and nucleic acid synthesis." .

ex:Asparagine rdf:type owl:Class ;
    rdfs:subClassOf bfo:MaterialEntity ;
    rdfs:subClassOf ex:AmideAminoAcid ;
    skos:definition "An Asparagine is an AminoAcid that is necessary for brain development and function." ;
    rdfs:comment "Asparagine is an amide amino acid crucial for brain development and function." .

ex:GlutamicAcid rdf:type owl:Class ;
    rdfs:subClassOf bfo:MaterialEntity ;
    rdfs:subClassOf ex:AcidicAminoAcid ;
    skos:definition "A GlutamicAcid is an AminoAcid that serves as a source of energy for the brain, improves brain clarity, mental alertness, and mood, and is used to treat Parkinson's, Fatigue, and Schizophrenia." ;
    rdfs:comment "Glutamic Acid is an acidic amino acid vital for brain energy, cognition, and mood, used in treating neurological disorders." .

ex:BetaHydroxyGlutamicAcid rdf:type owl:Class ;
    rdfs:subClassOf bfo:MaterialEntity ;
    rdfs:subClassOf ex:AminoAcid ;
    skos:definition "A BetaHydroxyGlutamicAcid is an AminoAcid that is used to treat acne, photoaging, dry skin, psoriasis, and melasma, and has been studied for fibromyalgia, dental scaling, dry mouth, and urinary tract stones." ;
    rdfs:comment "Beta-Hydroxy Glutamic Acid is an amino acid used for dermatological conditions and studied for other health issues." .

ex:Glutamine rdf:type owl:Class ;
    rdfs:subClassOf bfo:MaterialEntity ;
    rdfs:subClassOf ex:AmideAminoAcid ;
    skos:definition "A Glutamine is an AminoAcid that is used to keep blood sugar levels under control and consistent." ;
    rdfs:comment "Glutamine is an amide amino acid that helps regulate blood sugar levels." .

ex:Ornithine rdf:type owl:Class ;
    rdfs:subClassOf bfo:MaterialEntity ;
    rdfs:subClassOf ex:AminoAcid ;
    skos:definition "An Ornithine is an AminoAcid that is primarily used in health supplements to support sports and performance, and to help with liver function and wound healing." ;
    rdfs:comment "Ornithine is an amino acid used for sports performance, liver function, and wound healing." .

ex:Arginine rdf:type owl:Class ;
    rdfs:subClassOf bfo:MaterialEntity ;
    rdfs:subClassOf ex:BasicAminoAcid ;
    skos:definition "An Arginine is an AminoAcid that plays an important role in the treatment of cardiovascular disease due to its antiatherogenic, anti-ischemic, antiplatelet, and antithrombotic effects." ;
    rdfs:comment "Arginine is a basic amino acid beneficial for cardiovascular health." .

ex:Lysine rdf:type owl:Class ;
    rdfs:subClassOf bfo:MaterialEntity ;
    rdfs:subClassOf ex:AminoAcid ;
    skos:definition "A Lysine is an AminoAcid that appears to minimize cold sores when taken orally or applied topically." ;
    rdfs:comment "Lysine is an amino acid used to manage cold sores." .

ex:Histidine rdf:type owl:Class ;
    rdfs:subClassOf bfo:MaterialEntity ;
    rdfs:subClassOf ex:BasicAminoAcid ;
    skos:definition "A Histidine is an AminoAcid that is used to treat anemia and can reduce blood pressure, and is critical in baby feeding." ;
    rdfs:comment "Histidine is a basic amino acid important for hemoglobin, blood pressure, and infant nutrition." .

ex:DPenicillamine rdf:type owl:Class ;
    rdfs:subClassOf bfo:MaterialEntity ;
    rdfs:subClassOf ex:NonStandardAminoAcid ;
    skos:definition "A D-Penicillamine is a NonStandardAminoAcid that is a metabolite of penicillin and is employed in the chelation therapy of Wilson’s disease." ;
    rdfs:comment "D-Penicillamine is a non-standard amino acid used for Wilson's disease treatment." .

ex:NAcetylcysteine rdf:type owl:Class ;
    rdfs:subClassOf bfo:MaterialEntity ;
    rdfs:subClassOf ex:NonStandardAminoAcid ;
    skos:definition "A N-Acetylcysteine is a NonStandardAminoAcid that is used in cystic fibrosis and chronic renal insufficiency as an antioxidant." ;
    rdfs:comment "N-Acetylcysteine is a non-standard amino acid used as an antioxidant for respiratory and kidney conditions." .

ex:Gabapentin rdf:type owl:Class ;
    rdfs:subClassOf bfo:MaterialEntity ;
    rdfs:subClassOf ex:NonStandardAminoAcid ;
    skos:definition "A Gabapentin is a NonStandardAminoAcid that is used as an anticonvulsant." ;
    rdfs:comment "Gabapentin is a non-standard amino acid used as an anticonvulsant medication." .

ex:NonStandardAminoAcid rdf:type owl:Class ;
    rdfs:subClassOf bfo:MaterialEntity ;
    rdfs:subClassOf ex:AminoAcid ;
    skos:definition "A NonStandardAminoAcid is an AminoAcid that is not one of the 20 standard proteinogenic amino acids, and can be used as drugs." ;
    rdfs:comment "Non-standard amino acids are amino acids not typically found in proteins, some of which have medicinal uses." .

ex:AminoAceticAcid rdf:type owl:Class ;
    rdfs:subClassOf bfo:MaterialEntity ;
    rdfs:subClassOf ex:AminoAcid ;
    skos:definition "An AminoAceticAcid is an AminoAcid that is the chemical name for Glycine." ;
    rdfs:comment "AminoAceticAcid is the chemical name for Glycine." .

ex:AlphaAminopropionicAcid rdf:type owl:Class ;
    rdfs:subClassOf bfo:MaterialEntity ;
    rdfs:subClassOf ex:AminoAcid ;
    skos:definition "An AlphaAminopropionicAcid is an AminoAcid that is the chemical name for Alanine." ;
    rdfs:comment "AlphaAminopropionicAcid is the chemical name for Alanine." .

ex:AlphaAminoisovalericAcid rdf:type owl:Class ;
    rdfs:subClassOf bfo:MaterialEntity ;
    rdfs:subClassOf ex:AminoAcid ;
    skos:definition "An AlphaAminoisovalericAcid is an AminoAcid that is the chemical name for Valine." ;
    rdfs:comment "AlphaAminoisovalericAcid is the chemical name for Valine." .

ex:AlphaAminoisocaproicAcid rdf:type owl:Class ;
    rdfs:subClassOf bfo:MaterialEntity ;
    rdfs:subClassOf ex:AminoAcid ;
    skos:definition "An AlphaAminoisocaproicAcid is an AminoAcid that is the chemical name for Leucine." ;
    rdfs:comment "AlphaAminoisocaproicAcid is the chemical name for Leucine." .

ex:AlphaAminoBetaMethylNValericAcid rdf:type owl:Class ;
    rdfs:subClassOf bfo:MaterialEntity ;
    rdfs:subClassOf ex:AminoAcid ;
    skos:definition "An AlphaAminoBetaMethylNValericAcid is an AminoAcid that is the chemical name for Isoleucine." ;
    rdfs:comment "AlphaAminoBetaMethylNValericAcid is the chemical name for Isoleucine." .

ex:AlphaAminoNCaproicAcid rdf:type owl:Class ;
    rdfs:subClassOf bfo:MaterialEntity ;
    rdfs:subClassOf ex:AminoAcid ;
    skos:definition "An AlphaAminoNCaproicAcid is an AminoAcid that is the chemical name for Norleucine." ;
    rdfs:comment "AlphaAminoNCaproicAcid is the chemical name for Norleucine." .

ex:AlphaAminoBetaPhenylpropionicAcid rdf:type owl:Class ;
    rdfs:subClassOf bfo:MaterialEntity ;
    rdfs:subClassOf ex:AminoAcid ;
    skos:definition "An AlphaAminoBetaPhenylpropionicAcid is an AminoAcid that is the chemical name for Phenylalanine." ;
    rdfs:comment "AlphaAminoBetaPhenylpropionicAcid is the chemical name for Phenylalanine." .

ex:AlphaAminoBetaPHydroxyphenylPropionicAcid rdf:type owl:Class ;
    rdfs:subClassOf bfo:MaterialEntity ;
    rdfs:subClassOf ex:AminoAcid ;
    skos:definition "An AlphaAminoBetaPHydroxyphenylPropionicAcid is an AminoAcid that is the chemical name for Tyrosine." ;
    rdfs:comment "AlphaAminoBetaPHydroxyphenylPropionicAcid is the chemical name for Tyrosine." .

ex:AlphaAminoBetaHydroxypropionicAcid rdf:type owl:Class ;
    rdfs:subClassOf bfo:MaterialEntity ;
    rdfs:subClassOf ex:AminoAcid ;
    skos:definition "An AlphaAminoBetaHydroxypropionicAcid is an AminoAcid that is the chemical name for Serine." ;
    rdfs:comment "AlphaAminoBetaHydroxypropionicAcid is the chemical name for Serine." .

ex:AlphaAminoBetaMercaptopropionicAcid rdf:type owl:Class ;
    rdfs:subClassOf bfo:MaterialEntity ;
    rdfs:subClassOf ex:AminoAcid ;
    skos:definition "An AlphaAminoBetaMercaptopropionicAcid is an AminoAcid that is the chemical name for Cysteine." ;
    rdfs:comment "AlphaAminoBetaMercaptopropionicAcid is the chemical name for Cysteine." .

ex:AlphaAminoBetaHydroxyNButyricAcid rdf:type owl:Class ;
    rdfs:subClassOf bfo:MaterialEntity ;
    rdfs:subClassOf ex:AminoAcid ;
    skos:definition "An AlphaAminoBetaHydroxyNButyricAcid is an AminoAcid that is the chemical name for Threonine." ;
    rdfs:comment "AlphaAminoBetaHydroxyNButyricAcid is the chemical name for Threonine." .

ex:AlphaAminoGammaMethylthioNButyricAcid rdf:type owl:Class ;
    rdfs:subClassOf bfo:MaterialEntity ;
    rdfs:subClassOf ex:AminoAcid ;
    skos:definition "An AlphaAminoGammaMethylthioNButyricAcid is an AminoAcid that is the chemical name for Methionine." ;
