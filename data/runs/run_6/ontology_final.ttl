@prefix ex: <http://example.org/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# ===== OWL Classes =====
ex:AminoAcid rdf:type owl:Class ;
    rdfs:comment "Amino acid, any of a group of organic molecules that contains a basic amino group (−NH2), an acidic carboxyl group (−COOH), and an organic R group (or side chain) that's unique to every amino acid." .

ex:EssentialAminoAcid rdf:type owl:Class ;
    rdfs:comment "Amino acids that are not produced by the body and must be obtained through food. They're also known as essential amino acids." .

ex:SemiEssentialAminoAcid rdf:type owl:Class ;
    rdfs:comment "Amino acids generated in the body, but production is insufficient; these amino acids are referred to as semi-essential amino acids." .

ex:NonEssentialAminoAcid rdf:type owl:Class ;
    rdfs:comment "Amino acids that are generated in the body and do not require supplementation; these amino acids are referred to as non-essential amino acids." .

ex:ClassificationBasedOnNutritionalRequirement rdf:type owl:Class ;
    rdfs:comment "A classification system for amino acids based on their nutritional requirement. It includes Essential Amino Acids (EAA), Non-Essential Amino Acids (NEAA), and Semi-Essential Amino Acids (SEAA)." .

ex:ClassificationBasedOnMetabolicFates rdf:type owl:Class ;
    rdfs:comment "A classification system for amino acids based on their metabolic fates. It includes Purely Ketogenic Amino Acids, Ketogenic and Glucogenic Amino Acids, and Purely Glucogenic Amino Acids." .

ex:ClassificationBasedOnPolarity rdf:type owl:Class ;
    rdfs:comment "A classification system for amino acids based on their polarity. It includes Non-polar Amino Acids, Polar Amino Acids with no charge on 'R' group, Polar Amino Acids with positive 'R' group, and Polar Amino Acids with negative 'R' group." .

ex:ClassificationBasedOnStructure rdf:type owl:Class ;
    rdfs:comment "A classification system for amino acids based on their structural characteristics. It includes Aliphatic Side Chains, Hydroxyl Group-containing Amino Acids, Sulphur Containing Amino Acids, Acidic Amino Acids and their Amides, Basic Amino Acids, Aromatic Amino Acids, Imino Acids, and Heterocyclic Amino Acids." .

ex:AlphaAminoAcid rdf:type owl:Class ;
    rdfs:comment "A class for amino acids that have an alpha carbon atom as their backbone, which is a common characteristic of the amino acids mentioned in the text." .

ex:DrugUseCase rdf:type owl:Class ;
    rdfs:comment "A class to represent specific uses of amino acids as drugs or supplements." .

# ===== Properties =====
ex:isMadeUpOf rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range ex:Protein ;
    rdfs:comment "Protein is made up of amino acids, which are the building blocks of the molecule." .

ex:hasFunctionalGroups rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range ex:AminoGroup ex:CarboxylGroup ;
    rdfs:comment "The amino ( -NH2) group is basic, whereas the carboxyl ( -COOH) group is acidic." .

ex:hasRGroup rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range xsd:string ;
    rdfs:comment "The remaining two bonds of the α-carbon atom are generally satisfied by a hydrogen (H) atom and the R group [1–6, 9]." .

ex:isSolubleInWater rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Most of the amino acids are usually soluble in water and insoluble in organic solvents." .

ex:meltsAtHighTemperature rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Amino acids are generally melted at a higher temperature often above 2000 C." .

ex:hasTaste rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range xsd:string ;
    rdfs:comment "Taste Amino acids are also sweet (Glycine, Alanine and Valine), tasteless (Leucine) or Bitter (Arginine & Isoleucine)." .

ex:hasOpticalProperties rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range xsd:boolean ;
    rdfs:comment "All amino acids except glycine possess optical isomers because of the presence of asymmetric α-carbon atoms and show optical activity." .

ex:isZwitterion rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range xsd:boolean ;
    rdfs:comment "The name zwitter is derived from the German word which implies hybrid. Zwitter ion (or) dipolar ion is a hybrid molecule containing positive & negatively ionic groups." .

ex:hasIsomer rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Only if all four attachments are different can enantiomers occur [1, 2]." .

ex:isDecarboxylated rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range xsd:boolean ;
    rdfs:comment "The amino acids will undergo alpha Decarboxylation to make the corresponding amines." .

ex:formsSaltWithAlkalies rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Amino acids react with alkalies to make Salts." .

ex:formsEsterWithAlcohols rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Amino acids are reacted with an alcohol to form, Ester." .

ex:reactsWithAmmoniaToFormAmides rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range xsd:boolean ;
    rdfs:comment "The carboxyl group of dicarboxylic amino acids reacts with NH3 to form Amides." .

ex:formsSaltWithMineralAcids rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range xsd:boolean ;
    rdfs:comment "When the amino acids are treated with mineral acids (like HCl), it forms Acid Salts." .

ex:reactsWithNinhydrinToGiveColor rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range xsd:boolean ;
    rdfs:comment "When Amino acids (or) Imino acid react with Ninhydrin molecule it gives Color. When it gives Purple color (Ruhemanns Complex) the Unknown sample is Amino acids (Which have primary amine NH2) or it gives Yellow color the Unknown sample is Imino acid (-NH-)." .

ex:isClassifiedAs rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range ex:ClassificationBasedOnNutritionalRequirement ex:ClassificationBasedOnMetabolicFates ex:ClassificationBasedOnPolarity ex:ClassificationBasedOnStructure ;
    rdfs:comment "Indicates the classification of an amino acid based on its nutritional requirement, metabolic fate, polarity, and structure." .

ex:isProducedByHydrolysis rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether the amino acid is produced by hydrolysis of a larger molecule." .

ex:hasDrugUseCase rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range ex:DrugUseCase ;
    rdfs:comment "Links an amino acid to its specific use as a drug or supplement." .

# ===== Instances =====
# ===== Relations =====
