@prefix ex: <http://example.org/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# ===== OWL Classes =====
ex:AminoAcid rdf:type owl:Class ;
    rdfs:comment "Amino acid, any of a group of organic molecules that contain a basic amino group (NH2) and an acidic carboxyl group (COOH)." .

ex:Protein rdf:type owl:Class ;
    rdfs:comment "Protein is made up of amino acids, which are the building blocks of the molecule." .

ex:ChemicalSubstance rdf:type owl:Class ;
    rdfs:comment "A general class for chemical substances." .

ex:Element rdf:type owl:Class ;
    rdfs:comment "Element, a fundamental substance in chemistry." .

ex:BiologicalProcess rdf:type owl:Class ;
    rdfs:comment "A process related to biological functions." .

ex:Disease rdf:type owl:Class ;
    rdfs:comment "A medical condition affecting the body." .

ex:ChemicalReaction rdf:type owl:Class ;
    rdfs:comment "A process where substances interact to form or transform other substances." .

ex:PhysicalProperty rdf:type owl:Class ;
    rdfs:comment "A property related to the physical characteristics of a substance." .

ex:OpticalProperty rdf:type owl:Class ;
    rdfs:comment "A property related to the interaction of light with a substance." .

ex:Classification rdf:type owl:Class ;
    rdfs:comment "A categorization of amino acids based on their properties and functions." .

ex:EssentialAminoAcid rdf:type owl:Class ;
    rdfs:comment "Amino acids that the human body cannot synthesize and must be obtained from food." .

ex:SemiEssentialAminoAcid rdf:type owl:Class ;
    rdfs:comment "Amino acids that the human body can produce but at a rate insufficient to meet the body's demands, especially in growing children." .

ex:NonEssentialAminoAcid rdf:type owl:Class ;
    rdfs:comment "Amino acids that the human body can synthesize and do not need to be obtained from food." .

ex:AliphaticAminoAcid rdf:type owl:Class ;
    rdfs:comment "Amino acids with aliphatic side chains, including glycine, alanine, valine, leucine, and isoleucine." .

ex:HydroxylGroupContainingAminoAcid rdf:type owl:Class ;
    rdfs:comment "Amino acids with hydroxyl groups, including serine, threonine, and tyrosine." .

ex:SulphurContainingAminoAcid rdf:type owl:Class ;
    rdfs:comment "Amino acids containing sulfur, including cysteine and methionine." .

ex:AcidicAminoAcid rdf:type owl:Class ;
    rdfs:comment "Amino acids with acidic properties, including aspartic acid and glutamic acid." .

ex:BasicAminoAcid rdf:type owl:Class ;
    rdfs:comment "Amino acids with basic properties, including lysine, arginine, and histidine." .

ex:AromaticAminoAcid rdf:type owl:Class ;
    rdfs:comment "Amino acids with aromatic properties, including phenylalanine, tyrosine, and tryptophan." .

ex:IminoAminoAcid rdf:type owl:Class ;
    rdfs:comment "Amino acids with an imino group, including proline." .

ex:HeterocyclicAminoAcid rdf:type owl:Class ;
    rdfs:comment "Amino acids with heterocyclic structures, including histidine, tryptophan, and proline." .

ex:AlphaAminoAcid rdf:type owl:Class ;
    rdfs:comment "Amino acids with the amino group attached to the next carbon of the carboxyl group." .

ex:BetaAminoAcid rdf:type owl:Class ;
    rdfs:comment "Amino acids with the amino group attached to the third carbon of the carboxyl group." .

ex:GammaAminoAcid rdf:type owl:Class ;
    rdfs:comment "Amino acids with the amino group attached to the fourth carbon of the carboxyl group." .

ex:PurelyKetogenicAminoAcid rdf:type owl:Class ;
    rdfs:comment "Amino acids that can be used to make fat and are completely ketogenic." .

ex:KetogenicAndGlucogenicAminoAcid rdf:type owl:Class ;
    rdfs:comment "Amino acids that can be metabolized to produce both ketone bodies and glucose." .

ex:PurelyGlucogenicAminoAcid rdf:type owl:Class ;
    rdfs:comment "Amino acids that can be used as a starting point for the production of glucose or glycogen." .

ex:NonPolarAminoAcid rdf:type owl:Class ;
    rdfs:comment "Amino acids with no charge on the 'R' group, also known as hydrophobic amino acids." .

ex:PolarAminoAcidWithNoCharge rdf:type owl:Class ;
    rdfs:comment "Amino acids with an uncharged 'R' group but with groups like hydroxyl, sulfhydryl, and amide." .

ex:PolarAminoAcidWithPositiveCharge rdf:type owl:Class ;
    rdfs:comment "Amino acids with a positive charge on the 'R' group." .

ex:PolarAminoAcidWithNegativeCharge rdf:type owl:Class ;
    rdfs:comment "Amino acids with a negative charge on the 'R' group." .

ex:Hydroxyproline rdf:type owl:Class ;
    rdfs:comment "Hydroxyproline is required for the formation of collagen, the body's principal structural protein." .

ex:BetaHydroxyGlutamicAcid rdf:type owl:Class ;
    rdfs:comment "Used to treat acne, photoaging, dry skin, psoriasis, and melasma, among other dermatological diseases. Also studied for fibromyalgia, dental scaling, and dry mouth, as well as the prevention and treatment of urinary tract stones." .

ex:DPenicillamine rdf:type owl:Class ;
    rdfs:comment "A metabolite of penicillin, used in the chelation therapy of Wilson’s disease." .

ex:NACysteine rdf:type owl:Class ;
    rdfs:comment "Used in cystic fibrosis and chronic renal insufficiency as an antioxidant." .

ex:Gabapentin rdf:type owl:Class ;
    rdfs:comment "Used as an anticonvulsant." .

# ===== Properties =====
ex:hasComposition rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range ex:ChemicalSubstance ;
    rdfs:comment "The composition of an amino acid." .

ex:isComponentOf rdf:type owl:ObjectProperty ;
    rdfs:domain ex:Protein ;
    rdfs:range ex:AminoAcid ;
    rdfs:comment "Amino acids are components of proteins." .

ex:requiresDiet rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range ex:Element ;
    rdfs:comment "Amino acids must be included in the diet." .

ex:hasFunction rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range ex:BiologicalProcess ;
    rdfs:comment "Amino acids have functions in biological processes." .

ex:causesDisease rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range ex:Disease ;
    rdfs:comment "Amino acid deficiency can cause diseases." .

ex:undergoesReaction rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range ex:ChemicalReaction ;
    rdfs:comment "Amino acids undergo chemical reactions." .

ex:hasPhysicalProperty rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range ex:PhysicalProperty ;
    rdfs:comment "Amino acids have physical properties." .

ex:hasOpticalProperty rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range ex:OpticalProperty ;
    rdfs:comment "Amino acids have optical properties." .

ex:isClassifiedAs rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range ex:Classification ;
    rdfs:comment "Amino acids are classified based on their properties." .

ex:isEssential rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether the amino acid is essential." .

ex:isSemiEssential rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether the amino acid is semi-essential." .

ex:isNonEssential rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether the amino acid is non-essential." .

ex:hasAliphaticSideChain rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether the amino acid has an aliphatic side chain." .

ex:hasHydroxylGroup rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether the amino acid has a hydroxyl group." .

ex:hasSulphurGroup rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether the amino acid has a sulfur group." .

ex:hasAcidicGroup rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether the amino acid has an acidic group." .

ex:hasBasicGroup rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether the amino acid has a basic group." .

ex:hasAromaticGroup rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether the amino acid has an aromatic group." .

ex:hasIminoGroup rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether the amino acid has an imino group." .

ex:hasHeterocyclicGroup rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether the amino acid has a heterocyclic group." .

ex:isAlphaAminoAcid rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether the amino acid is an alpha-amino acid." .

ex:isBetaAminoAcid rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether the amino acid is a beta-amino acid." .

ex:isGammaAminoAcid rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether the amino acid is a gamma-amino acid." .

ex:isPurelyKetogenic rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether the amino acid is purely ketogenic." .

ex:isKetogenicAndGlucogenic rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether the amino acid is ketogenic and glucogenic." .

ex:isPurelyGlucogenic rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether the amino acid is purely glucogenic." .

ex:isNonPolar rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether the amino acid is non-polar." .

ex:isPolarWithNoCharge rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether the amino acid is polar with no charge." .

ex:isPolarWithPositiveCharge rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether the amino acid is polar with a positive charge." .

ex:isPolarWithNegativeCharge rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether the amino acid is polar with a negative charge." .

ex:isProducedByHydrolysis rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range ex:AminoAcid ;
    rdfs:comment "The amino acid produced by hydrolysis." .

ex:isProducedByGabrielPhthalimideSynthesis rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range ex:AminoAcid ;
    rdfs:comment "The amino acid produced by Gabriel Phthalimide synthesis." .

ex:isUsedInDrugTherapy rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether the amino acid is used in drug therapy." .

# ===== Instances =====
# ===== Relations =====
