@prefix ex: <http://example.org/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix bfo: <http://purl.obolibrary.org/obo/BFO_> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# ===== OWL Classes (BFO-anchored) =====
ex:AminoAcid rdf:type owl:Class ;
    rdfs:subClassOf bfo:MaterialEntity ;
    skos:definition "A AminoAcid is a MaterialEntity that contains an amino group (NH2) and a carboxyl group (-COOH)." ;
    rdfs:comment "" .

ex:EssentialAminoAcid rdf:type owl:Class ;
    rdfs:subClassOf bfo:MaterialEntity ;
    skos:definition "An EssentialAminoAcid is a MaterialEntity that cannot be produced by the body and must be obtained through food." ;
    rdfs:comment "" .

ex:NonEssentialAminoAcid rdf:type owl:Class ;
    rdfs:subClassOf bfo:MaterialEntity ;
    skos:definition "A NonEssentialAminoAcid is a MaterialEntity that can be produced by the body and does not require supplementation through food." ;
    rdfs:comment "" .

ex:SemiEssentialAminoAcid rdf:type owl:Class ;
    rdfs:subClassOf bfo:MaterialEntity ;
    skos:definition "A SemiEssentialAminoAcid is a MaterialEntity that can be produced by the body but in insufficient amounts, requiring supplementation through food." ;
    rdfs:comment "" .

ex:BranchedChainAminoAcid rdf:type owl:Class ;
    rdfs:subClassOf bfo:MaterialEntity ;
    skos:definition "A BranchedChainAminoAcid is a MaterialEntity that has an aliphatic side chain with a branched structure, typically found in naturally occurring amino acids such as Leucine, Isoleucine, and Valine." ;
    rdfs:comment "These amino acids are classified based on their structural characteristics." .

ex:HydroxylGroupContainingAminoAcid rdf:type owl:Class ;
    rdfs:subClassOf bfo:MaterialEntity ;
    skos:definition "A HydroxylGroupContainingAminoAcid is a MaterialEntity that contains an amino group and a hydroxyl (-OH) group in its side chain, typically found in Serine, Threonine, and Tyrosine." ;
    rdfs:comment "These amino acids are classified based on their structural characteristics." .

ex:AliphaticAminoAcid rdf:type owl:Class ;
    rdfs:subClassOf bfo:MaterialEntity ;
    skos:definition "An AliphaticAminoAcid is a MaterialEntity that has an aliphatic side chain, typically found in Glycine, Alanine, Valine, Leucine, and Isoleucine." ;
    rdfs:comment "These amino acids are classified based on their structural characteristics." .

ex:BasicAminoAcid rdf:type owl:Class ;
    rdfs:subClassOf bfo:MaterialEntity ;
    skos:definition "A BasicAminoAcid is a MaterialEntity that has a guanidino group or an imidazole ring in its side chain, typically found in Lysine, Arginine, and Histidine." ;
    rdfs:comment "These amino acids are classified based on their structural characteristics." .

ex:AromaticAminoAcid rdf:type owl:Class ;
    rdfs:subClassOf bfo:MaterialEntity ;
    skos:definition "An AromaticAminoAcid is a MaterialEntity that has an aromatic ring in its side chain, typically found in Phenylalanine, Tyrosine, and Tryptophan." ;
    rdfs:comment "These amino acids are classified based on their structural characteristics." .

ex:IminoAminoAcid rdf:type owl:Class ;
    rdfs:subClassOf bfo:MaterialEntity ;
    skos:definition "An IminoAminoAcid is a MaterialEntity that has an imino group in place of the amino group, typically found in Proline." ;
    rdfs:comment "These amino acids are classified based on their structural characteristics." .

ex:HeterocyclicAminoAcid rdf:type owl:Class ;
    rdfs:subClassOf bfo:MaterialEntity ;
    skos:definition "A HeterocyclicAminoAcid is a MaterialEntity that has a heterocyclic ring in its side chain, typically found in Histidine, Tryptophan, and Proline." ;
    rdfs:comment "These amino acids are classified based on their structural characteristics." .

ex:PurelyKetogenicAminoAcid rdf:type owl:Class ;
    rdfs:subClassOf bfo:MaterialEntity ;
    skos:definition "A PurelyKetogenicAminoAcid is a MaterialEntity that can be used to make fat during metabolism, typically found in Leucine and Lysine." ;
    rdfs:comment "These amino acids are classified based on their metabolic fate." .

ex:KetogenicAndGlucogenicAminoAcid rdf:type owl:Class ;
    rdfs:subClassOf bfo:MaterialEntity ;
    skos:definition "A KetogenicAndGlucogenicAminoAcid is a MaterialEntity that can be used to make fat and glucose during metabolism, typically found in Isoleucine, Phenylalanine, Tyrosine, and Tryptophan." ;
    rdfs:comment "These amino acids are classified based on their metabolic fate." .

ex:PurelyGlucogenicAminoAcid rdf:type owl:Class ;
    rdfs:subClassOf bfo:MaterialEntity ;
    skos:definition "A PurelyGlucogenicAminoAcid is a MaterialEntity that can be used to make glucose during metabolism, typically found in the remaining 14 amino acids." ;
    rdfs:comment "These amino acids are classified based on their metabolic fate." .

ex:NonPolarAminoAcid rdf:type owl:Class ;
    rdfs:subClassOf bfo:MaterialEntity ;
    skos:definition "A NonPolarAminoAcid is a MaterialEntity that has no charge on its 'R' group, typically found in Alanine, Leucine, Isoleucine, Valine, Methionine, Phenylalanine, Tryptophan, and Proline." ;
    rdfs:comment "These amino acids are classified based on their polarity." .

ex:PolarAminoAcidWithNoChargeOnRGroup rdf:type owl:Class ;
    rdfs:subClassOf bfo:MaterialEntity ;
    skos:definition "A PolarAminoAcidWithNoChargeOnRGroup is a MaterialEntity that has an uncharged 'R' group but contains groups like hydroxyl, sulfhydryl, and amide, typically found in Glycine, Serine, Threonine, Cysteine, Glutamine, Asparagine, and Tyrosine." ;
    rdfs:comment "These amino acids are classified based on their polarity." .

ex:PolarAminoAcidWithPositiveChargeOnRGroup rdf:type owl:Class ;
    rdfs:subClassOf bfo:MaterialEntity ;
    skos:definition "A PolarAminoAcidWithPositiveChargeOnRGroup is a MaterialEntity that has a positive charge on its 'R' group, typically found in Lysine, Arginine, and Histidine." ;
    rdfs:comment "These amino acids are classified based on their polarity." .

ex:PolarAminoAcidWithNegativeChargeOnRGroup rdf:type owl:Class ;
    rdfs:subClassOf bfo:MaterialEntity ;
    skos:definition "A PolarAminoAcidWithNegativeChargeOnRGroup is a MaterialEntity that has a negative charge on its 'R' group, typically found in Aspartic acid and Glutamic acid." ;
    rdfs:comment "These amino acids are classified based on their polarity." .

ex:HydrolysisProcess rdf:type owl:Class ;
    rdfs:subClassOf bfo:Process ;
    skos:definition "A process by which a material entity (amino acid) is produced from another material entity through the breaking of chemical bonds." ;
    rdfs:comment "Describes the transformation process in amino acid synthesis." .

ex:GabrielPhthalimideSynthesis rdf:type owl:Class ;
    rdfs:subClassOf bfo:Process ;
    skos:definition "A specific method for synthesizing amino acids by treating an alpha halogenated acid ester with potassium phthalimide, which is then hydrolyzed to yield the desired amino acid." ;
    rdfs:comment "Describes a chemical synthesis process." .

ex:ThreonineTreatment rdf:type owl:Class ;
    rdfs:subClassOf bfo:Process ;
    skos:definition "A therapeutic application of threonine for treating various conditions such as spinal spasticity, multiple sclerosis, familial spastic paraparesis, and amyotrophic lateral sclerosis." ;
    rdfs:comment "Describes the use of threonine in medical treatments." .

ex:HistidineSupplementation rdf:type owl:Class ;
    rdfs:subClassOf bfo:Process ;
    skos:definition "A process involving the supplementation of histidine to support various physiological functions, including treating anemia and reducing blood pressure." ;
    rdfs:comment "Describes the use of histidine in health supplements." .

ex:DietarySupplementation rdf:type owl:Class ;
    rdfs:subClassOf bfo:Process ;
    skos:definition "A process involving the intake of amino acids as dietary supplements for various health benefits, such as muscle synthesis and maintenance." ;
    rdfs:comment "Describes the use of amino acids in dietary supplementation." .

ex:CysteineTherapy rdf:type owl:Class ;
    rdfs:subClassOf bfo:Process ;
    skos:definition "A therapeutic application of cysteine to enhance the efficacy of corticosteroid medications and treat conditions such as surgery and trauma." ;
    rdfs:comment "Describes the use of cysteine in medical treatments." .

ex:OrnithineSupplementation rdf:type owl:Class ;
    rdfs:subClassOf bfo:Process ;
    skos:definition "A process involving the supplementation of ornithine to support sports and performance, liver function, and wound healing." ;
    rdfs:comment "Describes the use of ornithine in health supplements." .

ex:LysineTherapy rdf:type owl:Class ;
    rdfs:subClassOf bfo:Process ;
    skos:definition "A therapeutic application of lysine to reduce cold sores and treat protein deficiency." ;
    rdfs:comment "Describes the use of lysine in medical treatments." .

ex:NACSupplementation rdf:type owl:Class ;
    rdfs:subClassOf bfo:Process ;
    skos:definition "A process involving the supplementation of N-Acetylcysteine for treating cystic fibrosis, chronic renal insufficiency, and as an antioxidant." ;
    rdfs:comment "Describes the use of NAC in health supplements." .

ex:GabapentinTherapy rdf:type owl:Class ;
    rdfs:subClassOf bfo:Process ;
    skos:definition "A therapeutic application of gabapentin as an anticonvulsant." ;
    rdfs:comment "Describes the use of gabapentin in medical treatments." .

# ===== Properties =====
ex:hasFunction rdf:type owl:DatatypeProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range xsd:string ;
    rdfs:comment "Describes the function of an amino acid" .

ex:isProducedByBody rdf:type owl:DatatypeProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether an amino acid is produced by the body or not" .

ex:requiresSupplementationThroughFood rdf:type owl:DatatypeProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates if an amino acid requires supplementation through food" .

ex:hasChemicalReaction rdf:type owl:DatatypeProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range xsd:string ;
    rdfs:comment "Describes a chemical reaction involving the amino acid" .

ex:isSemiEssential rdf:type owl:DatatypeProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates if an amino acid is semi-essential and requires supplementation through food in growing children." .

ex:producedByHydrolysisProcess rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range ex:AminoAcid ;
    rdfs:comment "Describes the amino acid produced by a hydrolysis process." .

ex:treatmentForSchizophreniaAndSleepIssues rdf:type owl:DatatypeProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range xsd:string ;
    rdfs:comment "Indicates which amino acid is used to treat schizophrenia and sleep issues." .

ex:synthesizedByGabrielPhthalimideSynthesis rdf:type owl:DatatypeProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates if an amino acid can be synthesized by the Gabriel Phthalimide Synthesis method." .

ex:commonInHealthSupplements rdf:type owl:DatatypeProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range xsd:string ;
    rdfs:comment "Lists which amino acids are commonly used in health supplements for specific purposes." .

ex:increasesPhysicalPerformance rdf:type owl:DatatypeProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates if an amino acid increases physical performance or strength." .

ex:maintainsNitrogenBalance rdf:type owl:DatatypeProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates if an amino acid maintains nitrogen balance in adults." .

ex:usedInDrugDesign rdf:type owl:DatatypeProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range xsd:string ;
    rdfs:comment "Lists which non-standard amino acids are used as drugs." .

