@prefix ex: <http://example.org/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# ===== OWL Classes =====
ex:AminoAcid rdf:type owl:Class ;
    rdfs:comment "Amino acid, any of a group of organic molecules that contains a basic amino group (−NH2), an acidic carboxyl group (−COOH), and an organic R group (or side chain) that's unique to every amino acid." .

ex:EssentialAminoAcid rdf:type owl:Class ;
    rdfs:comment "These are amino acids that are not produced by the body and must be obtained through food. They're also known as essential amino acids." .

ex:SemiEssentialAminoAcid rdf:type owl:Class ;
    rdfs:comment "Some amino acids are generated in the body, but production is insufficient; these amino acids are referred to as semi-essential amino acids." .

ex:NonEssentialAminoAcid rdf:type owl:Class ;
    rdfs:comment "Some amino acids are generated in the body and do not require supplementation; these amino acids are referred to as non-essential amino acids." .

ex:AminoAcidClassificationBasedOnStructure rdf:type owl:Class ;
    rdfs:comment "A classification of amino acids based on their structural characteristics. This includes aliphatic, hydroxyl group-containing, sulfur containing, acidic and amides, basic, aromatic, imino, heterocyclic." .

ex:AminoAcidClassificationBasedOnPositionOfNH2 rdf:type owl:Class ;
    rdfs:comment "A classification of amino acids based on the position of -NH2. This includes α-amino acid, β-amino acid, and γ-amino acid." .

ex:AminoAcidClassificationBasedOnNutritionalRequirement rdf:type owl:Class ;
    rdfs:comment "A classification of amino acids based on their nutritional requirement. This includes essential amino acids (EAA), non-essential amino acids (NEAA), and semi-essential amino acids (SEAA)." .

ex:AminoAcidClassificationBasedOnMetabolicFate rdf:type owl:Class ;
    rdfs:comment "A classification of amino acids based on their metabolic fate. This includes purely ketogenic, ketogenic and glucogenic, and purely glucogenic." .

ex:AminoAcidClassificationBasedOnPolarity rdf:type owl:Class ;
    rdfs:comment "A classification of amino acids based on their polarity. This includes non-polar, polar with no charge on 'R' group, polar with positive 'R' group, and polar with negative 'R' group." .

ex:http://example.org/amino_acids#Glycine rdf:type owl:Class ;
    rdfs:comment "Used to treat schizophrenia, stroke, sleep issues, BPH, metabolic syndrome, and a few uncommon inherited metabolic illnesses. Also used in the Gabriel Phthalimide Synthesis method." .

ex:http://example.org/amino_acids#Alanine rdf:type owl:Class ;
    rdfs:comment "Utilized to boost immunity and provide energy to the brain and central nervous system. Used in health supplements for muscle synthesis and maintenance, stress management, child growth, and immune system support." .

ex:http://example.org/amino_acids#Valine rdf:type owl:Class ;
    rdfs:comment "Most commonly used in health supplements for its involvement in muscle synthesis and maintenance. Also supports stress management, child growth, and immune system support." .

ex:http://example.org/amino_acids#Leucine rdf:type owl:Class ;
    rdfs:comment "Increases short-term physical performance or strength. Prevents muscle loss in various conditions including immobility. Helps lower blood glucose levels in type 2 diabetes." .

ex:http://example.org/amino_acids#Isoleucine rdf:type owl:Class ;
    rdfs:comment "Required for children's optimal growth and maintaining nitrogen balance in adults. Also supports stress management, child growth, and immune system support." .

ex:http://example.org/amino_acids#Norleucine rdf:type owl:Class ;
    rdfs:comment "Artificial amino acid used to research protein structure and function in the lab. Has a similar structure to Methionine." .

ex:http://example.org/amino_acids#Phenylalanine rdf:type owl:Class ;
    rdfs:comment "Used to treat depression, inflammation, liver illness, muscle discomfort, weight loss, cholesterol reduction, and muscle development. Also used in the production of thyroid hormone." .

ex:http://example.org/amino_acids#Tyrosine rdf:type owl:Class ;
    rdfs:comment "Commonly utilized in the production of thyroid hormone. Helps with mental performance, alertness, and memory. Used to treat depression, migraines, headaches, and anxiety." .

ex:http://example.org/amino_acids#Serine rdf:type owl:Class ;
    rdfs:comment "Significant for brain and central nervous system function. Also used in the treatment of spinal spasticity, multiple sclerosis, familial spastic paraparesis, and amyotrophic lateral sclerosis." .

ex:http://example.org/amino_acids#Cysteine rdf:type owl:Class ;
    rdfs:comment "Used to boost corticosteroid medication efficiency. Used in the treatment of surgery and trauma." .

ex:http://example.org/amino_acids#Threonine rdf:type owl:Class ;
    rdfs:comment "Used to treat spinal spasticity, multiple sclerosis, familial spastic paraparesis, and amyotrophic lateral sclerosis." .

ex:http://example.org/amino_acids#Methionine rdf:type owl:Class ;
    rdfs:comment "Used to prevent and cure depression, inflammation, liver illness, muscle discomfort. Also used in the treatment of weight loss, cholesterol reduction, and muscle development." .

ex:http://example.org/amino_acids#IodogorgicAcid rdf:type owl:Class ;
    rdfs:comment "A type of medicine used to help people reduce weight, lower cholesterol, and develop muscle. Also known as Diiodothyronine." .

ex:http://example.org/amino_acids#Thyroxine rdf:type owl:Class ;
    rdfs:comment "Used to treat thyroid underactivity (hypothyroidism). Replaces or increases the amount of thyroid hormone generated by the thyroid gland." .

ex:http://example.org/amino_acids#Tryptophan rdf:type owl:Class ;
    rdfs:comment "Used to treat anxiety and depression. Also used in the treatment of migraines, headaches, and to boost growth hormone production." .

ex:http://example.org/amino_acids#Proline rdf:type owl:Class ;
    rdfs:comment "Used to improve joint and skin health. May also help with muscle development and injury healing." .

ex:http://example.org/amino_acids#Hydroxyproline rdf:type owl:Class ;
    rdfs:comment "Required for the formation of collagen, the body's principal structural protein. Also used in the treatment of acne, photoaging, dry skin, psoriasis, melasma, fibromyalgia, dental scaling, and dry mouth." .

ex:http://example.org/amino_acids#AsparticAcid rdf:type owl:Class ;
    rdfs:comment "Used to treat stress and exhaustion. Aids in the generation of energy from carbohydrates as well as RNA and DNA production." .

ex:http://example.org/amino_acids#Asparagine rdf:type owl:Class ;
    rdfs:comment "Necessary for brain development and function. Also used in the treatment of fibromyalgia, dental scaling, dry mouth, and prevention/treatment of urinary tract stones." .

ex:http://example.org/amino_acids#GlutamicAcid rdf:type owl:Class ;
    rdfs:comment "Serves as a source of energy for the brain. Improves brain clarity, mental alertness, and mood. Used to treat Parkinson's disease, fatigue, and schizophrenia." .

ex:http://example.org/amino_acids#Beta-HydroxyGlutamicAcid rdf:type owl:Class ;
    rdfs:comment "Used in the treatment of acne, photoaging, dry skin, psoriasis, melasma, fibromyalgia, dental scaling, and dry mouth. Also studied for prevention/treatment of urinary tract stones." .

ex:http://example.org/amino_acids#Glutamine rdf:type owl:Class ;
    rdfs:comment "Used to maintain blood sugar levels. Supports sports and performance in health supplements. Also used to support liver function and wound healing." .

ex:http://example.org/amino_acids#Arginine rdf:type owl:Class ;
    rdfs:comment "Non-essential amino acid with antiatherogenic, anti-ischemic, antiplatelet, and antithrombotic effects. Plays a role in the treatment of cardiovascular disease." .

ex:http://example.org/amino_acids#Lysine rdf:type owl:Class ;
    rdfs:comment "Minimizes cold sores when taken orally or applied as a cream. Used to treat anemia and reduce blood pressure. Also used in baby feeding." .

ex:http://example.org/amino_acids#Histidine rdf:type owl:Class ;
    rdfs:comment "Used to treat anemia, reduce blood pressure, and support infant feeding. Also used in the production of hemoglobin." .

# ===== Properties =====
ex:isMadeUpOf rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range ex:Protein ;
    rdfs:comment "Protein is made up of amino acids, which are the building blocks of the molecule." .

ex:hasFunctionalGroup rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range ex:AminoGroup ex:CarboxylGroup ;
    rdfs:comment "The amino ( -NH2) group is basic, whereas the carboxyl ( -COOH) group is acidic." .

ex:hasRGroup rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range xsd:string ;
    rdfs:comment "The remaining two bonds of the α-carbon atom are generally satisfied by a hydrogen (H) atom and the R group [1–6, 9]." .

ex:isSolubleIn rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range ex:Water ;
    rdfs:comment "Most of the amino acids are usually soluble in water and insoluble in organic solvents." .

ex:meltsAt rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range xsd:integer ;
    rdfs:comment "Amino acids are generally melted at a higher temperature often above 2000 C." .

ex:tastes rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range xsd:string ;
    rdfs:comment "Taste: Amino acids are also sweet (Glycine, Alanine and Valine), tasteless (Leucine) or Bitter (Arginine & Isoleucine)." .

ex:hasOpticalIsomer rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range xsd:boolean ;
    rdfs:comment "All amino acids except glycine possess optical isomers because of the presence of asymmetric α-carbon atoms and show optical activity." .

ex:hasZwitterion rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range xsd:boolean ;
    rdfs:comment "The name zwitter is derived from the German word which implies hybrid. Zwitter ion (or) dipolar ion is a hybrid molecule containing positive & negatively ionic groups." .

ex:hasIsoelectricPoint rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range xsd:float ;
    rdfs:comment "The proton shifts from the carboxyl group to the amino group of the self-molecule at normal pH cellular levels." .

ex:undergoesDecarboxylation rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range xsd:string ;
    rdfs:comment "The amino acids will undergo alpha Decarboxylation to make the corresponding amines. Histidine → Histamine + CO2 Tyrosine → Tyramine + CO2 Tryptophan → Tryptamine + CO2" .

ex:reactsWithAlkalies rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range xsd:string ;
    rdfs:comment "Amino acids react with alkalies to make Salts." .

ex:reactsWithAlcohols rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range xsd:string ;
    rdfs:comment "Amino acids are reacted with an alcohol to form, Ester." .

ex:reactsWithAmmonia rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range xsd:string ;
    rdfs:comment "The carboxyl group of dicarboxylic amino acids reacts with NH3 to form Amides. Aspartic acid + NH3→ Asparagine Glutamic acid + NH3→Glutamine" .

ex:reactsWithMineralAcids rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range xsd:string ;
    rdfs:comment "When the amino acids are treated with mineral acids (like HCl), it forms Acid Salts." .

ex:hasNinhydrinReaction rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range xsd:boolean ;
    rdfs:comment "When Amino acids (or) Imino acid react with Ninhydrin molecule it gives Color. When it gives Purple color (Ruhemanns Complex) the Unknown sample is Amino acids (Which have primary amine NH2) or it gives Yellow color the Unknown sample is Imino acid (-NH-)." .

ex:isLOrD rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range xsd:string ;
    rdfs:comment "Only L-amino acids are manufactured in cells and incorporated into proteins. Some D -amino acids are found within the cell walls of bacteria, but not in bacterial proteins." .

ex:isEssential rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Eight amino acids are very important for humans. E.g. Valine, Leucine, Isoleucine, Threonine, Methionine, Phenylalanine, Tryptophan, and Lysine." .

ex:isSemiEssential rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Some amino acids are generated in the body, but production is insufficient; these amino acids are referred to as semi-essential amino acids." .

ex:isNonEssential rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Some amino acids are generated in the body and do not require supplementation; these amino acids are referred to as non-essential amino acids." .

ex:isClassifiedBasedOnStructure rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range ex:AminoAcidClassificationBasedOnStructure ;
    rdfs:comment "Indicates the classification of an amino acid based on its structural characteristics." .

ex:isClassifiedBasedOnPositionOfNH2 rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range ex:AminoAcidClassificationBasedOnPositionOfNH2 ;
    rdfs:comment "Indicates the classification of an amino acid based on the position of -NH2." .

ex:isClassifiedBasedOnNutritionalRequirement rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range ex:AminoAcidClassificationBasedOnNutritionalRequirement ;
    rdfs:comment "Indicates the classification of an amino acid based on its nutritional requirement." .

ex:isClassifiedBasedOnMetabolicFate rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range ex:AminoAcidClassificationBasedOnMetabolicFate ;
    rdfs:comment "Indicates the classification of an amino acid based on its metabolic fate." .

ex:isClassifiedBasedOnPolarity rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range ex:AminoAcidClassificationBasedOnPolarity ;
    rdfs:comment "Indicates the classification of an amino acid based on its polarity." .

ex:http://example.org/amino_acids#chemicalName rdf:type owl:ObjectProperty ;
    rdfs:domain ex:http://example.org/amino_acids#AminoAcid ;
    rdfs:range xsd:string ;
    rdfs:comment "Chemical name of the amino acid." .

ex:http://example.org/amino_acids#threeLetterAbbreviation rdf:type owl:ObjectProperty ;
    rdfs:domain ex:http://example.org/amino_acids#AminoAcid ;
    rdfs:range xsd:string ;
    rdfs:comment "Three-letter abbreviation of the amino acid." .

ex:http://example.org/amino_acids#oneLetterAbbreviation rdf:type owl:ObjectProperty ;
    rdfs:domain ex:http://example.org/amino_acids#AminoAcid ;
    rdfs:range xsd:string ;
    rdfs:comment "One-letter abbreviation of the amino acid." .

ex:http://example.org/amino_acids#primaryFunction rdf:type owl:ObjectProperty ;
    rdfs:domain ex:http://example.org/amino_acids#AminoAcid ;
    rdfs:range xsd:string ;
    rdfs:comment "Primary function of the amino acid in the body." .

ex:http://example.org/amino_acids#specificApplication rdf:type owl:ObjectProperty ;
    rdfs:domain ex:http://example.org/amino_acids#AminoAcid ;
    rdfs:range xsd:string ;
    rdfs:comment "Specific applications of the amino acid in medical or dietary contexts." .

# ===== Instances =====
# ===== Relations =====
