@prefix ex: <http://example.org/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# ===== OWL Classes =====
ex:AminoAcid rdf:type owl:Class ;
    rdfs:comment "A general class representing amino acids." .

ex:EssentialAminoAcid rdf:type owl:Class ;
    rdfs:comment "A specific type of amino acid that is essential for the body and must be obtained through food." .

ex:SemiEssentialAminoAcid rdf:type owl:Class ;
    rdfs:comment "A specific type of amino acid that can be produced in small amounts by the body but may need to be supplemented from food." .

ex:NonEssentialAminoAcid rdf:type owl:Class ;
    rdfs:comment "A specific type of amino acid that is not essential and can be synthesized by the body." .

ex:AliphaticAminoAcid rdf:type owl:Class ;
    rdfs:comment "A class representing amino acids with aliphatic side chains." .

ex:HeterocyclicAminoAcid rdf:type owl:Class ;
    rdfs:comment "A class representing amino acids with heterocyclic structures." .

ex:PurelyKetogenicAminoAcid rdf:type owl:Class ;
    rdfs:comment "A class for amino acids that are purely ketogenic in metabolism." .

ex:KetogenicAndGlucogenicAminoAcid rdf:type owl:Class ;
    rdfs:comment "A class for amino acids that are both ketogenic and glucogenic in metabolism." .

ex:PurelyGlucogenicAminoAcid rdf:type owl:Class ;
    rdfs:comment "A class for amino acids that are purely glucogenic in metabolism." .

ex:Cystine rdf:type owl:Class ;
    rdfs:comment "A specific type of amino acid that is a disulfide derivative of cysteine." .

ex:Dipeptide rdf:type owl:Class ;
    rdfs:comment "A class representing peptides formed by the covalent bonding of two amino acids." .

# ===== Properties =====
ex:hasCanonicalName rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range xsd:string ;
    rdfs:comment "Maps an amino acid to its canonical name." .

ex:isEssential rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether the amino acid is essential for the body." .

ex:hasProperties rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range ex:AminoAcidProperty ;
    rdfs:comment "Lists properties of an amino acid such as solubility, melting point, etc." .

ex:isDecarboxylatedTo rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range ex:AminoAcid ;
    rdfs:comment "Indicates the amino acid that results from decarboxylation of another amino acid." .

ex:reactsWithAlcohol rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether an amino acid can react with alcohol to form esters." .

ex:classifiesAsAliphatic rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether the amino acid is classified as aliphatic based on its side chain." .

ex:classifiesAsHeterocyclic rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether the amino acid is classified as heterocyclic based on its structure." .

ex:isPurelyKetogenic rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether the amino acid is purely ketogenic in metabolism." .

ex:isKetogenicAndGlucogenic rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether the amino acid is both ketogenic and glucogenic in metabolism." .

ex:isPurelyGlucogenic rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether the amino acid is purely glucogenic in metabolism." .

ex:isDisulfideBondedTo rdf:type owl:ObjectProperty ;
    rdfs:domain ex:Cystine ;
    rdfs:range ex:AminoAcid ;
    rdfs:comment "Indicates which amino acid is bonded to cystine via a disulfide bond." .

ex:formsDipeptideWith rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range ex:AminoAcid ;
    rdfs:comment "Indicates the amino acid that forms a dipeptide with another amino acid." .

