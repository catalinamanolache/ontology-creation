    rdfs:domain ex:WindEnergyTechnology ;
    rdfs:range xsd:string ;
    rdfs:comment "Provides estimates of material intensity in kg/MW for wind turbines." .

ex:hasGHGEmissionsRange rdf:type owl:DatatypeProperty ;
    rdfs:domain ex:WindEnergyTechnology ;
    rdfs:range xsd:string ;
    rdfs:comment "The range of Greenhouse Gas (GHG) emissions in gCO2eqv/kWh for onshore and offshore wind power plants." .

ex:hasEnergyPaybackTime rdf:type owl:DatatypeProperty ;
    rdfs:domain ex:WindEnergyTechnology ;
    rdfs:range xsd:string ;
    rdfs:comment "The Energy Pay-Back Time (EPBT) for wind power plants, indicating the time required to generate the energy consumed during its lifecycle." .

ex:discussesBiodiversityEnhancementInNorthSea rdf:type owl:DatatypeProperty ;
    rdfs:domain ex:Report ;
    rdfs:range xsd:string ;
    rdfs:comment "Indicates that a report discusses opportunities for biodiversity enhancement in the North Sea related to offshore wind farms." .

ex:hasRAndIProjectsFundedByHorizonEurope rdf:type owl:ObjectProperty ;
    rdfs:domain ex:Report ;
    rdfs:range ex:WindEnergyResearchProject ;
    rdfs:comment "Relates a report to the wind energy research and innovation projects funded under the Horizon Europe programme that started in a specific year." .

ex:hasExposureSymptom rdf:type owl:ObjectProperty ;
    rdfs:domain ex:WindEnergyTechnology ;
    rdfs:range ex:ExposureSymptom ;
    rdfs:comment "Relates wind energy technology to reported exposure symptoms." .

ex:hasAnnoyanceFromNoiseImmissionLevel rdf:type owl:DatatypeProperty ;
    rdfs:domain ex:WindEnergyTechnology ;
    rdfs:range xsd:string ;
    rdfs:comment "Describes the relationship between annoyance from wind turbine noise and the immission level." .

ex:hasStatisticallySignificantSleepDisturbanceAssociation rdf:type owl:DatatypeProperty ;
    rdfs:domain ex:WindEnergyTechnology ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether a statistically significant association between noise levels and self-reported sleep disturbance was found." .

ex:hasEMFLevelComparison rdf:type owl:DatatypeProperty ;
    rdfs:domain ex:WindEnergyTechnology ;
    rdfs:range xsd:string ;
    rdfs:comment "Compares electromagnetic field (EMF) levels from wind turbines to those in urban areas." .

ex:hasShadowFlickerImpactOnResidents rdf:type owl:DatatypeProperty ;
    rdfs:domain ex:WindEnergyTechnology ;
    rdfs:range xsd:string ;
    rdfs:comment "Describes the impact on residents caused by the periodic casting of shadows from wind turbine rotors onto surrounding buildings." .

ex:hasPublicAcceptanceDriver rdf:type owl:ObjectProperty ;
    rdfs:domain ex:WindEnergyTechnology ;
    rdfs:range ex:PublicAcceptanceDriver ;
    rdfs:comment "Identifies factors influencing public acceptance or opposition to wind energy projects." .

ex:hasRepoweringDriver rdf:type owl:ObjectProperty ;
    rdfs:domain ex:WindEnergyTechnology ;
    rdfs:range ex:RepoweringDriver ;
    rdfs:comment "Identifies factors that drive wind energy repowering projects." .

ex:hasLandscapeImpactOnRepowering rdf:type owl:DatatypeProperty ;
    rdfs:domain ex:WindEnergyTechnology ;
    rdfs:range xsd:string ;
    rdfs:comment "Describes the impact of repowering wind turbines on the local landscape." .

ex:hasLocalOppositionForLifetimeExtension rdf:type owl:DatatypeProperty ;
    rdfs:domain ex:WindEnergyTechnology ;
    rdfs:range xsd:string ;
    rdfs:comment "Describes the perceived local opposition for lifetime extension of existing wind farms compared to repowering." .

ex:hasPolicyInstrument rdf:type owl:DatatypeProperty ;
    rdfs:domain ex:POTENCIACETOScenario ;
    rdfs:range xsd:string ;
    rdfs:comment "Identifies a policy instrument that influences technology uptake within the POTEnCIA CETO 2024 scenario." .

ex:hasEmissionReductionTarget rdf:type owl:DatatypeProperty ;
    rdfs:domain ex:POTENCIACETOScenario ;
    rdfs:range xsd:string ;
    rdfs:comment "Specifies an emission reduction target for the EU by a certain year within the POTEnCIA CETO 2024 scenario." .

ex:hasMethodologicalApproach rdf:type owl:DatatypeProperty ;
    rdfs:domain ex:POLESJRCModel ;
    rdfs:range xsd:string ;
    rdfs:comment "Describes the methodological approach used by the POLES-JRC model for simulating energy systems." .

ex:includesPowerGeneratingTechnology rdf:type owl:DatatypeProperty ;
    rdfs:domain ex:POLESJRCModelPowerSystem ;
    rdfs:range xsd:string ;
    rdfs:comment "Indicates a power generating technology included in the POLES-JRC model's power system description." .

ex:considersHydrogenProductionRoute rdf:type owl:DatatypeProperty ;
    rdfs:domain ex:POLESJRCModelHydrogenProduction ;
    rdfs:range xsd:string ;
    rdfs:comment "Identifies a hydrogen production route considered within the POLES-JRC model." .

ex:usesHydrogenInSector rdf:type owl:DatatypeProperty ;
    rdfs:domain ex:POLESJRCModelHydrogenProduction ;
    rdfs:range xsd:string ;
    rdfs:comment "Specifies a sector where hydrogen is used as a fuel or feedstock within the POLES-JRC model." .

ex:considersCCUSInSector rdf:type owl:DatatypeProperty ;
    rdfs:domain ex:POLESJRCModelCCUS ;
    rdfs:range xsd:string ;
    rdfs:comment "Specifies a sector where Carbon Capture, Utilization, and Storage (CCUS) technologies are considered within the POLES-JRC model." .

ex:capturesTechnologyLearningFor rdf:type owl:DatatypeProperty ;
    rdfs:domain ex:TechnologyLearningInPOLESJRC ;
    rdfs:range xsd:string ;
    rdfs:comment "Describes the clean energy technology for which the POLES-JRC model captures technology learning effects." .

ex:operatesOnYearlyBasisUpTo rdf:type owl:DatatypeProperty ;
    rdfs:domain ex:POLESJRCModel ;
    rdfs:range xsd:integer ;
    rdfs:comment "Specifies the yearly operational time horizon of the POLES-JRC model." .

ex:isUpdatedYearlyWith rdf:type owl:DatatypeProperty ;
    rdfs:domain ex:POLESJRCModel ;
    rdfs:range xsd:string ;
    rdfs:comment "Indicates that the POLES-JRC model is updated yearly with specific types of information." .

ex:learningRate rdf:type owl:DatatypeProperty ;
    rdfs:domain ex:TechnologyLearningInPOLESJRC ;
    rdfs:range xsd:decimal ;
    rdfs:comment "Quantifies the percentage change of the cost of an energy technology based on a doubling of its cumulative capacity or production." .

ex:floorCost rdf:type owl:DatatypeProperty ;
    rdfs:domain ex:ComponentLevelLearning ;
    rdfs:range xsd:decimal ;
    rdfs:comment "Specifies the minimum achievable investment cost for a component or technology, acting as a limit for cost reduction through learning." .

ex:hasEUFinancialContribution rdf:type owl:DatatypeProperty ;
    rdfs:domain ex:HorizonEuropeRAndIProject ;
    rdfs:range xsd:integer ;
    rdfs:comment "The EU financial contribution in EUR for a Horizon Europe funded R&I project." .

ex:hasResearchArea rdf:type owl:DatatypeProperty ;
    rdfs:domain ex:HorizonEuropeRAndIProject ;
    rdfs:range xsd:string ;
    rdfs:comment "The research area or focus of a Horizon Europe funded R&I project." .

ex:differsFromScenario rdf:type owl:ObjectProperty ;
    rdfs:domain ex:POTENCIACETOScenario ;
    rdfs:range ex:EnergySystemScenario ;
    rdfs:comment "Indicates how this scenario differs from another energy system scenario, particularly in terms of model version, parameter updates, or driving logic." .

ex:drivenBy rdf:type owl:DatatypeProperty ;
    rdfs:domain ex:EnergySystemScenario ;
    rdfs:range xsd:string ;
    rdfs:comment "Describes the primary driver or logic behind an energy system scenario, such as a global carbon price or alignment with climate laws." .

ex:considersPolicy rdf:type owl:DatatypeProperty ;
    rdfs:domain ex:EnergySystemScenario ;
    rdfs:range xsd:string ;
    rdfs:comment "Specifies the climate policies or legislative packages considered within an energy system scenario." .

