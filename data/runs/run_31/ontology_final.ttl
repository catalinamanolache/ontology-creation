@prefix ex: <http://example.org/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix bfo: <http://purl.obolibrary.org/obo/BFO_> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# ===== OWL Classes (BFO-anchored) =====
ex:Report rdf:type owl:Class ;
    rdfs:subClassOf bfo:InformationContentEntity ;
    skos:definition "A Report is an InformationContentEntity that records structured information about technology development, trends, value chains and markets." ;
    rdfs:comment "" .

ex:TechnologyDevelopmentStatusReport rdf:type owl:Class ;
    rdfs:subClassOf bfo:InformationContentEntity ;
    skos:definition "A TechnologyDevelopmentStatusReport is an InformationContentEntity that documents the status and trends of technology development, including readiness levels, deployment, costs, funding, patenting, and scientific publication." ;
    rdfs:comment "" .

ex:WindEnergyTechnology rdf:type owl:Class ;
    rdfs:subClassOf bfo:MaterialEntity ;
    skos:definition "A WindEnergyTechnology is a MaterialEntity that represents the technology used for generating electricity from wind energy." ;
    rdfs:comment "" .

ex:CETOProject rdf:type owl:Class ;
    rdfs:subClassOf bfo:InformationContentEntity ;
    skos:definition "A project that monitors EU research and innovation activities on clean energy technologies, assesses the competitiveness of the EU clean energy sector, builds on existing Commission studies, and publishes reports." ;
    rdfs:comment "Covers objectives and contributions from colleagues." .

ex:AnnualProgressReport rdf:type owl:Class ;
    rdfs:subClassOf bfo:InformationContentEntity ;
    skos:definition "A report published annually by the Commission on the competitiveness of clean energy technologies, serving as a primary source of data." ;
    rdfs:comment "Documents annual progress in clean energy technology." .

ex:RenewableEnergyShareTarget rdf:type owl:Class ;
    rdfs:subClassOf bfo:Quality ;
    skos:definition "A target set by the EU for its renewable energy share, aiming to reach at least 42.5% of final energy consumption by 2030." ;
    rdfs:comment "Defines the renewable energy goal." .

ex:OnshoreWindCostReduction rdf:type owl:Class ;
    rdfs:subClassOf bfo:Process ;
    skos:definition "The process of reducing the cost of onshore wind between 2010 and 2022, resulting in a levelised cost of energy (LCoE) of EUR 31 per MWh." ;
    rdfs:comment "Tracks the cost reduction trend." .

ex:GlobalMarketShare rdf:type owl:Class ;
    rdfs:subClassOf bfo:Quality ;
    skos:definition "The share of the global wind turbine market held by Chinese, European, and North American OEMs as of 2023." ;
    rdfs:comment "Represents market position." .

ex:EURDFrameworkProgrammeInvestment rdf:type owl:Class ;
    rdfs:subClassOf bfo:Process ;
    skos:definition "The investment in wind energy research and development by the EU framework programmes, including Horizon 2020 and Horizon Europe." ;
    rdfs:comment "Tracks R&D funding." .

ex:PrivateRDInvestment rdf:type owl:Class ;
    rdfs:subClassOf bfo:Process ;
    skos:definition "The process of private research and development funding invested in various technologies, particularly focusing on wind energy." ;
    rdfs:comment "Covers the investment percentage from 2010 to 2020." .

ex:SWOTAnalysis rdf:type owl:Class ;
    rdfs:subClassOf bfo:InformationContentEntity ;
    skos:definition "A structured analysis of strengths, weaknesses, opportunities, and threats related to the competitiveness of the EU wind energy sector." ;
    rdfs:comment "Maps to CETO SWOT analysis for the competitiveness of the EU wind energy sector." .

ex:TechnologyReadinessLevel rdf:type owl:Class ;
    rdfs:subClassOf bfo:Quality ;
    skos:definition "The stage of technological development, indicating how close a technology is to commercialization." ;
    rdfs:comment "Covers the current TRL of onshore and bottom-fixed offshore wind turbines." .

ex:FloatingOffshoreWindSubstructure rdf:type owl:Class ;
    rdfs:subClassOf bfo:MaterialEntity ;
    skos:definition "The substructures used in floating offshore wind technology to provide buoyancy and stability." ;
    rdfs:comment "Includes types like Spar-buoy, Semi-Submersible, TLP, Barge, and Multi-Platforms." .

ex:PreCommercialFloatingOffshoreWindDesign rdf:type owl:Class ;
    rdfs:subClassOf bfo:InformationContentEntity ;
    skos:definition "The design of floating offshore wind technology that has been deployed pre-commercially." ;
    rdfs:comment "Includes designs like Spar-buoy and Semi-Submersible in the North Sea and Atlantic Ocean." .

ex:LowerTRLTechnology rdf:type owl:Class ;
    rdfs:subClassOf bfo:MaterialEntity ;
    skos:definition "Technologies generating electricity that are at a lower technology readiness level than onshore and bottom-fixed offshore wind turbines." ;
    rdfs:comment "Includes technologies like Airborne Wind Energy Systems (AWES) and Vertical Axis Wind Turbines (VAWT)." .

ex:AirborneWindEnergySystem rdf:type owl:Class ;
    rdfs:subClassOf bfo:MaterialEntity ;
    skos:definition "A technology that converts wind energy into electricity using autonomous kites or unmanned aircrafts, linked to the ground by one or more tethers." ;
    rdfs:comment "Airborne wind energy systems are at a lower TRL than other wind technologies." .

ex:VerticalAxisWindTurbine rdf:type owl:Class ;
    rdfs:subClassOf bfo:MaterialEntity ;
    skos:definition "A type of wind turbine that uses a vertical shaft around which the rotor turns, offering lower efficiency compared to horizontal axis wind turbines but potentially gaining momentum through hybridization or small-scale applications." ;
    rdfs:comment "Vertical axis wind turbines are less efficient than conventional horizontal axis wind turbines." .

ex:OnshoreWindInstalledCapacity2030 rdf:type owl:Class ;
    rdfs:subClassOf bfo:MaterialEntity ;
    skos:definition "The projected installed capacity of onshore wind in the EU by 2030 under the POTEnCIA CETO 2024 scenario." ;
    rdfs:comment "This class represents a specific projection for onshore wind energy." .

ex:OnshoreWindInstalledCapacity2050 rdf:type owl:Class ;
    rdfs:subClassOf bfo:MaterialEntity ;
    skos:definition "The projected installed capacity of onshore wind in the EU by 2050 under the POTEnCIA CETO 2024 scenario." ;
    rdfs:comment "This class represents a specific projection for onshore wind energy." .

ex:OffshoreWindInstalledCapacity2030 rdf:type owl:Class ;
    rdfs:subClassOf bfo:MaterialEntity ;
    skos:definition "The projected installed capacity of offshore wind in the EU by 2030 under the POTEnCIA CETO 2024 scenario." ;
    rdfs:comment "This class represents a specific projection for offshore wind energy." .

ex:OffshoreWindInstalledCapacity2050 rdf:type owl:Class ;
    rdfs:subClassOf bfo:MaterialEntity ;
    skos:definition "The projected installed capacity of offshore wind in the EU by 2050 under the POTEnCIA CETO 2024 scenario." ;
    rdfs:comment "This class represents a specific projection for offshore wind energy." .

ex:GlobalWindEnergyInstalledCapacity2030 rdf:type owl:Class ;
    rdfs:subClassOf bfo:MaterialEntity ;
    skos:definition "The projected installed capacity of global wind energy by 2030 under the Global CETO 2°C scenario 2024." ;
    rdfs:comment "This class represents a specific projection for global wind energy." .

ex:GlobalWindEnergyInstalledCapacity2050 rdf:type owl:Class ;
    rdfs:subClassOf bfo:MaterialEntity ;
    skos:definition "The projected installed capacity of global wind energy by 2050 under the Global CETO 2°C scenario 2024." ;
    rdfs:comment "This class represents a specific projection for global wind energy." .

ex:http://example.org/vc_pe_investment_stages rdf:type owl:Class ;
    rdfs:subClassOf bfo:Entity ;
    skos:definition "A classification of venture capital and private equity investments based on the stage of development of the investee company." ;
    rdfs:comment "This class is used to categorize different stages of VC/PE investment." .

ex:InvestmentDealStage rdf:type owl:Class ;
    rdfs:subClassOf bfo:Quality ;
    skos:definition "An InvestmentDealStage is a Quality that categorizes venture capital and private equity investments based on the developmental phase of the company receiving the investment." ;
    rdfs:comment "A classification of venture capital and private equity investments based on the stage of development of the investee company." .

ex:WindEnergyInvestment rdf:type owl:Class ;
    rdfs:subClassOf bfo:Process ;
    skos:definition "A WindEnergyInvestment is a Process that represents the financial commitment of venture capital and private equity into the wind energy sector." ;
    rdfs:comment "Venture capital and private equity investment in the wind energy sector." .

ex:WindEnergyInvention rdf:type owl:Class ;
    rdfs:subClassOf bfo:MaterialEntity ;
    skos:definition "A WindEnergyInvention is a MaterialEntity that represents a novel creation or discovery within the field of wind energy, often protected by patent families." ;
    rdfs:comment "A novel creation or discovery in the wind energy sector, represented by patent families." .

ex:HighValueInvention rdf:type owl:Class ;
    rdfs:subClassOf bfo:Entity ;
    skos:definition "A HighValueInvention is a WindEnergyInvention that is considered significant due to its broad protection across multiple patent offices, indicating substantial commercial or technological importance." ;
    rdfs:comment "A wind energy invention considered high-value due to patent applications filed in more than one patent office." .

ex:InternationalInvention rdf:type owl:Class ;
    rdfs:subClassOf bfo:Entity ;
    skos:definition "An InternationalInvention is a WindEnergyInvention where the patent application is protected in a country other than the applicant's residence, signifying cross-border intellectual property protection." ;
    rdfs:comment "A wind energy invention for which patent applications are protected in a country other than the applicant's residence." .

ex:CooperativePatentClassificationCode rdf:type owl:Class ;
    rdfs:subClassOf bfo:InformationContentEntity ;
    skos:definition "A CooperativePatentClassificationCode is an InformationContentEntity that serves as a standardized code used to categorize and evaluate patenting activity within a specific technological domain." ;
    rdfs:comment "A standardized code used for evaluating patenting activity in the wind sector." .

ex:WindEnergyPublication rdf:type owl:Class ;
    rdfs:subClassOf bfo:InformationContentEntity ;
    skos:definition "A WindEnergyPublication is an InformationContentEntity that represents a peer-reviewed article or other scholarly work discussing research and findings in the field of wind energy." ;
    rdfs:comment "A peer-reviewed article or scholarly work related to the wind energy sector." .

ex:HighlyCitedPublication rdf:type owl:Class ;
    rdfs:subClassOf bfo:Entity ;
    skos:definition "A HighlyCitedPublication is a WindEnergyPublication that belongs to the top 10% most cited papers within its field and year, indicating significant impact and recognition." ;
    rdfs:comment "A wind energy publication that is among the top 10% most cited papers in its field and year." .

ex:CountryPublicationImpact rdf:type owl:Class ;
    rdfs:subClassOf bfo:Quality ;
    skos:definition "A CountryPublicationImpact is a Quality that measures the citation impact of publications from a specific country relative to the global average for that research field." ;
    rdfs:comment "A measure of the citation impact of publications from a country compared to the global average in the research field." .

ex:CountryPublicationProductivity rdf:type owl:Class ;
    rdfs:subClassOf bfo:Quality ;
    skos:definition "A CountryPublicationProductivity is a Quality that assesses both the output (productivity) and the citation impact (h-index) of publications originating from a specific country." ;
    rdfs:comment "A measure of both the productivity and citation impact of publications from a country." .

ex:OriginalEquipmentManufacturer rdf:type owl:Class ;
    rdfs:subClassOf bfo:Role ;
    skos:definition "An OriginalEquipmentManufacturer is a Role that designs, manufactures, and sells equipment under its own brand name, particularly in the context of the wind energy sector." ;
    rdfs:comment "A company that manufactures and sells equipment, often in the wind energy sector, under its own brand." .

ex:CountryPublicationActivity rdf:type owl:Class ;
    rdfs:subClassOf bfo:InformationContentEntity ;
    skos:definition "A CountryPublicationActivity is an InformationContentEntity that represents the scholarly output of a specific country in the field of wind energy research, measured by the number of peer-reviewed articles published within a defined period." ;
    rdfs:comment "Represents the number of peer-reviewed articles published by a country in wind energy research." .

ex:CollaborationNetwork rdf:type owl:Class ;
    rdfs:subClassOf bfo:InformationContentEntity ;
    skos:definition "A CollaborationNetwork is an InformationContentEntity that visualizes and describes the co-publication relationships between different entities (e.g., countries, organizations) in a specific research domain." ;
    rdfs:comment "Describes the co-publication relationships between entities in a research domain." .

ex:WindEnergyResearchProject rdf:type owl:Class ;
    rdfs:subClassOf bfo:InformationContentEntity ;
    skos:definition "A WindEnergyResearchProject is an InformationContentEntity that represents a funded initiative or program focused on advancing research and innovation within the wind energy sector." ;
    rdfs:comment "Represents a funded initiative or program in wind energy research and innovation." .

ex:RecyclingCircularityProject rdf:type owl:Class ;
    rdfs:subClassOf bfo:Entity ;
    skos:definition "A RecyclingCircularityProject is a WindEnergyResearchProject that specifically focuses on developing solutions for recycling and promoting circular economy principles within the wind energy sector, particularly concerning end-of-life components." ;
    rdfs:comment "A wind energy research project focused on recycling and circularity solutions." .

ex:BladeRecyclingProject rdf:type owl:Class ;
    rdfs:subClassOf bfo:Entity ;
    rdfs:subClassOf ex:RecyclingCircularityProject ;
    skos:definition "A BladeRecyclingProject is a RecyclingCircularityProject that aims to develop and implement recycling solutions for wind turbine blades." ;
    rdfs:comment "A project focused on developing recycling solutions for wind turbine blades." .

ex:GridIntegrationProject rdf:type owl:Class ;
    rdfs:subClassOf bfo:Entity ;
    rdfs:subClassOf ex:WindEnergyResearchProject ;
    skos:definition "A GridIntegrationProject is a WindEnergyResearchProject that focuses on improving the integration of wind energy into existing power grids, including aspects like converter interoperability and smart curtailment." ;
    rdfs:comment "A wind energy research project focused on improving grid integration." .

ex:ConverterInteroperabilityProject rdf:type owl:Class ;
    rdfs:subClassOf bfo:Entity ;
    rdfs:subClassOf ex:GridIntegrationProject ;
    skos:definition "A ConverterInteroperabilityProject is a GridIntegrationProject that aims to enhance the grid-forming capabilities and interoperability of offshore and onshore converters within high-voltage direct current systems." ;
    rdfs:comment "A project focused on improving the interoperability of converters for grid integration." .

ex:FloatingOffshoreWindProject rdf:type owl:Class ;
    rdfs:subClassOf bfo:Entity ;
    rdfs:subClassOf ex:WindEnergyResearchProject ;
    skos:definition "A FloatingOffshoreWindProject is a WindEnergyResearchProject that focuses on the development, demonstration, or industrialization of floating offshore wind technologies." ;
    rdfs:comment "A wind energy research project focused on floating offshore wind technology." .

ex:BatterySupplyChainProject rdf:type owl:Class ;
    rdfs:subClassOf bfo:Entity ;
    skos:definition "A BatterySupplyChainProject is a WindEnergyResearchProject that aims to establish a sustainable end-to-end supply chain for lithium-ion batteries, particularly for applications in electric vehicles and renewable energy sources like solar and wind farms." ;
    rdfs:comment "A project focused on establishing a sustainable supply chain for lithium-ion batteries used in renewable energy." .

ex:http://example.org/TWAIN rdf:type owl:Class ;
    rdfs:subClassOf bfo:Entity ;
    skos:definition "A project focusing on the efficient deployment of AI in wind farm control and asset management to optimize operation for cost, performance, and efficiency while considering environmental and societal aspects." ;
    rdfs:comment "Priority: Maintenance and condition monitoring systems" .

ex:http://example.org/ULTFARMS rdf:type owl:Class ;
    rdfs:subClassOf bfo:Entity ;
    skos:definition "A project developing novel designs in six low trophic aquaculture pilots in offshore wind farm locations across the North and Baltic Seas to understand environmental impacts." ;
    rdfs:comment "Priority: Environmental impacts of wind energy" .

ex:http://example.org/off-coustics rdf:type owl:Class ;
    rdfs:subClassOf bfo:Entity ;
    skos:definition "A project aiming to achieve a comprehensive understanding of the acoustic repercussions of wind turbines, specifically their potential negative impact on marine life through acoustic damage." ;
    rdfs:comment "Priority: Environmental impacts of wind energy" .

ex:http://example.org/FLOW rdf:type owl:Class ;
    rdfs:subClassOf bfo:Entity ;
    skos:definition "A project developing new prediction methods for production statistics and load performance of modern GW-scale and 400-metre tall offshore and onshore wind energy systems." ;
    rdfs:comment "Priority: Resource assessment" .

ex:http://example.org/MADE4WIND rdf:type owl:Class ;
    rdfs:subClassOf bfo:Entity ;
    skos:definition "A project developing and testing innovative components for a 15 MW floating wind turbine, including new designs and manufacturing techniques in lightweight materials, recyclability, and advanced software tools." ;
    rdfs:comment "Priority: New materials and components" .

ex:http://example.org/Nanowings rdf:type owl:Class ;
    rdfs:subClassOf bfo:Entity ;
    skos:definition "A project improving wind turbine performance and durability by developing nanocoating based on a blended formulation of super-glue polymers combined with nanoparticles, providing outstanding anti-icing and anti-fouling properties." ;
    rdfs:comment "Priority: New materials and components" .

ex:http://example.org/WIMBY rdf:type owl:Class ;
    rdfs:subClassOf bfo:Entity ;
    skos:definition "A project studying the drivers and barriers of social acceptance to address related challenges, gaining more popular support for wind energy." ;
    rdfs:comment "Priority: Social engagement" .

ex:http://example.org/DATA-DRIVEN OFFSHORE rdf:type owl:Class ;
    rdfs:subClassOf bfo:Entity ;
    skos:definition "A project revolutionizing aerohydroelastic simulations used in wind turbine research and development by integrating experimental data into these simulations." ;
    rdfs:comment "Priority: Offshore technology" .

ex:http://example.org/Orcelle rdf:type owl:Class ;
    rdfs:subClassOf bfo:Entity ;
    skos:definition "A project developing a solution involving wind as the main form of propulsion, aiming for an energy efficiency gain of more than 50%." ;
    rdfs:comment "Priority: Other (shipping sector)" .

ex:http://example.org/WHISPER rdf:type owl:Class ;
    rdfs:subClassOf bfo:Entity ;
    skos:definition "A project developing a modular retrofit solution, including a wingsail system for wind-assisted propulsion and testing efficiency savings of more than 20%." ;
    rdfs:comment "Priority: Other (shipping sector)" .

ex:http://example.org/i4Offshore rdf:type owl:Class ;
    rdfs:subClassOf bfo:Entity ;
    skos:definition "A project aiming to reduce cost barriers in large-scale offshore developments by optimizing low-cost manufacturing through a hybrid-material gravity jacket foundation." ;
    rdfs:comment "Priority: Offshore technology" .

ex:http://example.org/COREWIND rdf:type owl:Class ;
    rdfs:subClassOf bfo:Entity ;
    skos:definition "A project contributing to cost and environmental footprint reductions in floating offshore wind energy systems by using digital tools and optimizing designs for station-keeping systems and dynamic cables." ;
    rdfs:comment "Priority: Offshore technology" .

ex:http://example.org/SUSMAGPRO rdf:type owl:Class ;
    rdfs:subClassOf bfo:Entity ;
    skos:definition "A project focusing on recycling and reusing neodymium-containing magnets from waste, creating a shorter recycling loop with higher recovery rate and increased yield." ;
    rdfs:comment "Priority: Recycling and circularity" .

ex:http://example.org/NAWEP rdf:type owl:Class ;
    rdfs:subClassOf bfo:Entity ;
    skos:definition "A project aiming to construct and operate an onshore array of at least twelve 100 kW AWES devices, generating a combined 1.2 MW with targeted cost and carbon footprint reductions." ;
    rdfs:comment "Priority: Airborne wind energy systems" .

ex:http://example.org/Aquilon rdf:type owl:Class ;
    rdfs:subClassOf bfo:Entity ;
    skos:definition "A project serving as a demonstrator for airborne wind energy production at 160 kW scale and an integrated renewable energy and storage solution." ;
    rdfs:comment "Priority: Airborne wind energy systems" .

ex:http://example.org/N2OWF rdf:type owl:Class ;
    rdfs:subClassOf bfo:Entity ;
    skos:definition "A project building and operating a first-of-its-kind offshore wind farm with 450 MW capacity, combined with on-site production, storage, and offtake of green hydrogen." ;
    rdfs:comment "Priority: Offshore technology" .

ex:http://example.org/SUSTAIN-SEA rdf:type owl:Class ;
    rdfs:subClassOf bfo:Entity ;
    skos:definition "A project using wind energy to reduce fuel use and GHG emissions in the maritime transport sector by integrating a wind propulsion system into five large cargo vessels." ;
    rdfs:comment "Priority: Other (shipping sector)" .

ex:http://example.org/HIPPOW rdf:type owl:Class ;
    rdfs:subClassOf bfo:Entity ;
    skos:definition "A project aiming to build and operate a 15 MW floating wind turbine with innovative technologies including wind turbines, foundations, and hydrogen technology solutions." ;
    rdfs:comment "Priority: Offshore technology" .

ex:http://example.org/SEAWORTHY rdf:type owl:Class ;
    rdfs:subClassOf bfo:Entity ;
    skos:definition "A project building and operating a 15 MW floating wind turbine with innovative technologies including wind turbines, foundations, and hydrogen technology solutions." ;
    rdfs:comment "Priority: Offshore technology" .

ex:http://example.org/hippow_project rdf:type owl:Class ;
    rdfs:subClassOf bfo:Entity ;
    skos:definition "A commercial-scale demonstration of a technology capable of supplying clean dispatchable offshore power from wind, waves and hydrogen." ;
    rdfs:comment "HIPPOW project is described as a commercial-scale demonstration integrating various renewable energy sources." .

ex:http://example.org/seaworthy_project rdf:type owl:Class ;
    rdfs:subClassOf bfo:Entity ;
    skos:definition "A commercial-scale demonstration of technology capable of supplying clean dispatchable offshore power from wind, waves and hydrogen." ;
    rdfs:comment "SEAWORTHY project is described as a commercial-scale demonstration integrating various renewable energy sources." .

ex:http://example.org/wind_energy_trade rdf:type owl:Class ;
    rdfs:subClassOf bfo:Entity ;
    skos:definition "The exchange and flow of wind generating sets between different countries, particularly focusing on the EU's trade dynamics." ;
    rdfs:comment "This class captures the overall context of international trade in wind generating sets." .

ex:http://example.org/import_export_ratio rdf:type owl:Class ;
    rdfs:subClassOf bfo:Entity ;
    skos:definition "The ratio between extra-EU imports and exports, indicating market share dynamics." ;
    rdfs:comment "This class represents the quantitative relationship between imports and exports." .

ex:http://example.org/critical_raw_materials_supply_chain rdf:type owl:Class ;
    rdfs:subClassOf bfo:Entity ;
    skos:definition "The entire process from extraction to manufacturing of critical raw materials used in wind power plants, particularly focusing on rare earth elements and permanent magnets." ;
    rdfs:comment "This class describes the supply chain for essential components of wind turbines." .

ex:http://example.org/balsa_wood rdf:type owl:Class ;
    rdfs:subClassOf bfo:Entity ;
    skos:definition "A lightweight, stiff material used in wind turbine blades, especially in spar caps and blade cores." ;
    rdfs:comment "This class defines the specific material balsa wood and its usage." .

ex:http://example.org/material_intensity rdf:type owl:Class ;
    rdfs:subClassOf bfo:Entity ;
    skos:definition "The amount of raw or composite materials required per unit of installed capacity in wind turbines." ;
    rdfs:comment "This class quantifies the material requirements for wind turbine construction." .

ex:http://www.w3.org/2002/07/owl#Class rdf:type owl:Class ;
    rdfs:subClassOf bfo:Entity ;
    skos:definition "Critical raw materials used in wind energy technology, specifically Neodymium magnets." ;
    rdfs:comment "These are essential for the production of permanent magnets in turbine generators." .

ex:http://example.org/new_knowledge rdf:type owl:Class ;
    rdfs:subClassOf bfo:Entity ;
    skos:definition "A new piece of information derived from existing sources." ;
    rdfs:comment "This class represents the newly generated knowledge based on the references provided." .

ex:http://example.org/report_on_socio_economic_impacts_of_community_wind_power_projects_northern_scotland rdf:type owl:Class ;
    rdfs:subClassOf bfo:InformationContentEntity ;
    skos:definition "A report published by an organization on the socio-economic impacts of community wind power projects in Northern Scotland." ;
    rdfs:comment "Describes the socio-economic impacts of community wind power projects in Northern Scotland." .

ex:http://example.org/report_on_socio_economic_impact_study_of_offshore_wind rdf:type owl:Class ;
    rdfs:subClassOf bfo:InformationContentEntity ;
    skos:definition "A report published by an organization on the socio-economic impact study of offshore wind." ;
    rdfs:comment "Describes the socio-economic impact of offshore wind projects." .

ex:http://example.org/jrc_idees_2021_database_update_and_technical_documentation rdf:type owl:Class ;
    rdfs:subClassOf bfo:InformationContentEntity ;
    skos:definition "Technical documentation and database update for the Integrated Database of the European Energy System by the JRC." ;
    rdfs:comment "Provides updates and documentation for the JRC's energy system database." .

ex:http://example.org/wind_energy_technology_observatory_report rdf:type owl:Class ;
    rdfs:subClassOf bfo:InformationContentEntity ;
    skos:definition "A report published by the Clean Energy Technology Observatory on wind energy in the European Union." ;
    rdfs:comment "Reports on the technology development, trends, value chains, and markets of wind energy in the EU." .

ex:http://example.org/report_on_potencia_ceto_2024_scenario rdf:type owl:Class ;
    rdfs:subClassOf bfo:InformationContentEntity ;
    skos:definition "A report published by an organization on the POTEnCIA CETO 2024 scenario for EU energy outlook to 2050." ;
    rdfs:comment "Describes the scenario for the EU energy outlook to 2050 under the POTEnCIA framework." .

ex:OffshoreWindCapacityAddition rdf:type owl:Class ;
    rdfs:subClassOf bfo:Process ;
    skos:definition "An OffshoreWindCapacityAddition is a Process that represents the addition of new offshore wind power generation capacity over a specific period." ;
    rdfs:comment "Represents the annual or periodic increase in installed offshore wind power capacity." .

ex:OnshoreWindCapacityAddition rdf:type owl:Class ;
    rdfs:subClassOf bfo:Process ;
    skos:definition "An OnshoreWindCapacityAddition is a Process that represents the addition of new onshore wind power generation capacity over a specific period." ;
    rdfs:comment "Represents the annual or periodic increase in installed onshore wind power capacity." .

ex:OffshoreWindInstalledCapacity rdf:type owl:Class ;
    rdfs:subClassOf bfo:MaterialEntity ;
    skos:definition "An OffshoreWindInstalledCapacity is a MaterialEntity that represents the total cumulative installed capacity of offshore wind power generation at a specific point in time." ;
    rdfs:comment "Represents the total cumulative installed capacity of offshore wind power generation." .

ex:OnshoreWindInstalledCapacity rdf:type owl:Class ;
    rdfs:subClassOf bfo:MaterialEntity ;
    skos:definition "An OnshoreWindInstalledCapacity is a MaterialEntity that represents the total cumulative installed capacity of onshore wind power generation at a specific point in time." ;
    rdfs:comment "Represents the total cumulative installed capacity of onshore wind power generation." .

ex:WindEnergyGeneration rdf:type owl:Class ;
    rdfs:subClassOf bfo:Process ;
    skos:definition "A WindEnergyGeneration is a Process that represents the production of electricity from wind energy over a specific period." ;
    rdfs:comment "Represents the electricity generated by wind power." .

ex:WindEnergyLCOE rdf:type owl:Class ;
    rdfs:subClassOf bfo:Quality ;
    skos:definition "A WindEnergyLCOE is a Quality that represents the Levelized Cost of Energy for wind power, indicating the average revenue per unit of electricity generation needed to recover costs of building and operating a wind power plant." ;
    rdfs:comment "Represents the Levelized Cost of Energy for wind power." .

ex:WindEnergyInvestmentCost rdf:type owl:Class ;
    rdfs:subClassOf bfo:Quality ;
    skos:definition "A WindEnergyInvestmentCost is a Quality that represents the initial capital expenditure required for building wind energy installations." ;
    rdfs:comment "Represents the overnight investment costs for wind energy installations." .

ex:PublicRAndIInvestmentWindEnergy rdf:type owl:Class ;
    rdfs:subClassOf bfo:Process ;
    skos:definition "A PublicRAndIInvestmentWindEnergy is a Process that represents public funding allocated to research and innovation activities within the wind energy sector." ;
    rdfs:comment "Represents public investment in research and development for wind energy." .

ex:PrivateRAndIInvestmentWindEnergy rdf:type owl:Class ;
    rdfs:subClassOf bfo:Process ;
    skos:definition "A PrivateRAndIInvestmentWindEnergy is a Process that represents private funding allocated to research and innovation activities within the wind energy sector." ;
    rdfs:comment "Represents private investment in research and development for wind energy." .

ex:WindEnergyVCPEInvestment rdf:type owl:Class ;
    rdfs:subClassOf bfo:Process ;
    skos:definition "A WindEnergyVCPEInvestment is a Process that represents financial investment by venture capital and private equity firms into the wind energy sector." ;
    rdfs:comment "Represents venture capital and private equity investment in the wind energy sector." .

ex:WindEnergyInventionActivity rdf:type owl:Class ;
    rdfs:subClassOf bfo:Process ;
    skos:definition "A WindEnergyInventionActivity is a Process that represents the creation and documentation of new inventions within the wind energy sector." ;
    rdfs:comment "Represents the activity of inventing within the wind energy sector." .

ex:WindEnergyPublicationActivity rdf:type owl:Class ;
    rdfs:subClassOf bfo:Process ;
    skos:definition "A WindEnergyPublicationActivity is a Process that represents the creation and dissemination of peer-reviewed articles and scholarly works in the field of wind energy." ;
    rdfs:comment "Represents the activity of publishing research in the wind energy sector." .

ex:WindEnergyFundingEvolution rdf:type owl:Class ;
    rdfs:subClassOf bfo:Process ;
    skos:definition "A WindEnergyFundingEvolution is a Process that tracks the changes and trends in research and innovation funding for wind energy over time." ;
    rdfs:comment "Represents the evolution of funding for wind energy research and innovation." .

ex:WindSectorTurnover rdf:type owl:Class ;
    rdfs:subClassOf bfo:Process ;
    skos:definition "A WindSectorTurnover is a Process that represents the total revenue generated by the wind energy sector over a specific period." ;
    rdfs:comment "Represents the turnover of the wind energy sector." .

ex:WindSectorGVA rdf:type owl:Class ;
    rdfs:subClassOf bfo:Process ;
    skos:definition "A WindSectorGVA is a Process that represents the Gross Value Added generated by the wind energy sector, indicating its contribution to the economy." ;
    rdfs:comment "Represents the Gross Value Added of the wind energy sector." .

ex:WindTurbineMarketShare rdf:type owl:Class ;
    rdfs:subClassOf bfo:Quality ;
    skos:definition "A WindTurbineMarketShare is a Quality that represents the proportion of the global or regional market for wind turbines held by specific manufacturers or regions." ;
    rdfs:comment "Represents the market share of wind turbines." .

ex:WindEnergyEmployment rdf:type owl:Class ;
    rdfs:subClassOf bfo:Process ;
    skos:definition "A WindEnergyEmployment is a Process that represents the number of direct and indirect jobs within the wind energy sector over a specific period." ;
    rdfs:comment "Represents the evolution of direct and indirect jobs in the wind energy sector." .

ex:RawMaterial rdf:type owl:Class ;
    rdfs:subClassOf bfo:MaterialEntity ;
    skos:definition "A RawMaterial is a MaterialEntity that is a basic substance in its natural or processed state, used as a component in the manufacturing of wind power plants." ;
    rdfs:comment "Represents the basic substances used in the production of wind power plants." .

ex:MaterialIntensity rdf:type owl:Class ;
    rdfs:subClassOf bfo:Quality ;
    skos:definition "A MaterialIntensity is a Quality that quantifies the amount of raw or composite materials required per unit of installed capacity in wind turbines." ;
    rdfs:comment "Measures the material consumption per unit of wind turbine capacity." .

ex:WindTurbineType rdf:type owl:Class ;
    rdfs:subClassOf bfo:MaterialEntity ;
    rdfs:subClassOf ex:WindEnergyTechnology ;
    skos:definition "A WindTurbineType is a MaterialEntity that represents a specific category or design of wind turbine used for generating electricity from wind energy." ;
    rdfs:comment "Represents a specific classification or design of a wind turbine." .

ex:RareEarthElement rdf:type owl:Class ;
    rdfs:subClassOf bfo:MaterialEntity ;
    rdfs:subClassOf ex:RawMaterial ;
    skos:definition "A RareEarthElement is a RawMaterial that is a group of 17 chemically similar metallic elements with unique properties crucial for various high-tech applications, including wind turbine magnets." ;
    rdfs:comment "Represents rare earth elements used in wind turbine components, particularly magnets." .

ex:PermanentMagnet rdf:type owl:Class ;
    rdfs:subClassOf bfo:MaterialEntity ;
    rdfs:subClassOf ex:RawMaterial ;
    skos:definition "A PermanentMagnet is a RawMaterial that is a magnetic material that retains its magnetism after being magnetized, commonly used in wind turbine generators." ;
    rdfs:comment "Represents magnetic materials used in wind turbine generators." .

ex:OnshoreWindTurbine rdf:type owl:Class ;
    rdfs:subClassOf bfo:MaterialEntity ;
    rdfs:subClassOf ex:WindTurbineType ;
    skos:definition "An OnshoreWindTurbine is a WindTurbineType that is designed and installed for generating electricity from wind on land." ;
    rdfs:comment "Represents a wind turbine installed on land." .

ex:OffshoreWindTurbine rdf:type owl:Class ;
    rdfs:subClassOf bfo:MaterialEntity ;
    rdfs:subClassOf ex:WindTurbineType ;
    skos:definition "An OffshoreWindTurbine is a WindTurbineType that is designed and installed for generating electricity from wind in bodies of water." ;
    rdfs:comment "Represents a wind turbine installed offshore." .

ex:GHGEmissions rdf:type owl:Class ;
    rdfs:subClassOf bfo:Quality ;
    skos:definition "A GHGEmissions is a Quality that quantifies the amount of greenhouse gases released into the atmosphere per unit of energy produced by wind power plants." ;
    rdfs:comment "Quantifies greenhouse gas emissions associated with wind energy generation." .

ex:EnergyPaybackTime rdf:type owl:Class ;
    rdfs:subClassOf bfo:Quality ;
    skos:definition "An EnergyPaybackTime is a Quality that represents the time required for a wind energy system to generate the amount of energy equivalent to the energy consumed during its entire lifecycle." ;
    rdfs:comment "Measures the time it takes for a wind energy system to repay its energy investment." .

ex:BenthicBiodiversity rdf:type owl:Class ;
    rdfs:subClassOf bfo:MaterialEntity ;
    skos:definition "A BenthicBiodiversity is a MaterialEntity that represents the variety of life forms and their ecological interactions within the seabed environment." ;
    rdfs:comment "Refers to the biodiversity found on the bottom of marine or freshwater ecosystems." .

ex:SeabedRecovery rdf:type owl:Class ;
    rdfs:subClassOf bfo:Process ;
    skos:definition "A SeabedRecovery is a Process that describes the natural regeneration and restoration of the seabed ecosystem, potentially facilitated by reduced human activity." ;
    rdfs:comment "The process by which the seabed ecosystem recovers from disturbances or pressures." .

ex:BenthicFaunalBaseline rdf:type owl:Class ;
    rdfs:subClassOf bfo:InformationContentEntity ;
    skos:definition "A BenthicFaunalBaseline is an InformationContentEntity that serves as a reference point for the composition and abundance of benthic fauna against which future changes can be assessed." ;
    rdfs:comment "A foundational dataset describing the state of benthic fauna before significant development or change." .

ex:BlueWaterConsumption rdf:type owl:Class ;
    rdfs:subClassOf bfo:Quality ;
    skos:definition "A BlueWaterConsumption is a Quality that quantifies the net balance of freshwater inputs and outputs throughout the lifecycle of a product or process." ;
    rdfs:comment "Measures the freshwater footprint of an activity or product." .

ex:WaterScarcityFootprint rdf:type owl:Class ;
    rdfs:subClassOf bfo:Quality ;
    skos:definition "A WaterScarcityFootprint is a Quality that assesses the impact of water consumption on water availability in a specific region, using a defined methodology like AWARE." ;
    rdfs:comment "Quantifies the contribution to water scarcity based on available water remaining." .

ex:NdFeBMagnetProduction rdf:type owl:Class ;
    rdfs:subClassOf bfo:Process ;
    skos:definition "A NdFeBMagnetProduction is a Process that encompasses the manufacturing steps involved in creating Neodymium-Iron-Boron permanent magnets." ;
    rdfs:comment "The industrial process of manufacturing NdFeB permanent magnets." .

ex:ResourceDepletionWater rdf:type owl:Class ;
    rdfs:subClassOf bfo:Quality ;
    skos:definition "A ResourceDepletionWater is a Quality that measures the volume of water consumed during the extraction and processing of resources, contributing to water depletion." ;
    rdfs:comment "Quantifies water used in resource extraction and processing that leads to depletion." .

ex:HumanToxicityPotential rdf:type owl:Class ;
    rdfs:subClassOf bfo:Quality ;
    skos:definition "A HumanToxicityPotential is a Quality that measures the potential impact on human health from toxic substances released into the environment." ;
    rdfs:comment "An environmental impact category assessing health effects from toxic substances." .

ex:InstalledPowerDensity rdf:type owl:Class ;
    rdfs:subClassOf bfo:Quality ;
    skos:definition "An InstalledPowerDensity is a Quality that represents the amount of power generation capacity installed per unit of area." ;
    rdfs:comment "Measures the power output relative to the land or sea area occupied." .

ex:SoilAcidificationPotential rdf:type owl:Class ;
    rdfs:subClassOf bfo:Quality ;
    skos:definition "A SoilAcidificationPotential is a Quality that quantifies the potential for substances released during a process to cause acidification of the soil." ;
    rdfs:comment "An environmental impact category measuring the potential for soil acidification." .

ex:SoilEutrophicationPotential rdf:type owl:Class ;
    rdfs:subClassOf bfo:Quality ;
    skos:definition "A SoilEutrophicationPotential is a Quality that quantifies the potential for substances released during a process to cause excessive nutrient enrichment in the soil." ;
    rdfs:comment "An environmental impact category measuring the potential for soil eutrophication." .

ex:SoilPollution rdf:type owl:Class ;
    rdfs:subClassOf bfo:Quality ;
    skos:definition "A SoilPollution is a Quality that describes the presence of contaminants in the soil that can be harmful to the environment or human health." ;
    rdfs:comment "Contamination of soil by harmful substances." .

ex:HazardousMaterial rdf:type owl:Class ;
    rdfs:subClassOf bfo:MaterialEntity ;
    skos:definition "A HazardousMaterial is a MaterialEntity that possesses properties that make it capable of causing harm to human health or the environment." ;
    rdfs:comment "Substances that pose a risk due to their properties." .

ex:EconomicLCCStandard rdf:type owl:Class ;
    rdfs:subClassOf bfo:InformationContentEntity ;
    skos:definition "An EconomicLCCStandard is an InformationContentEntity that defines best practices or methodologies for assessing the life cycle cost of economic activities or projects." ;
    rdfs:comment "A standard or best practice for evaluating the total cost of ownership over a product's or project's lifecycle." .

ex:CriticalRawMaterial rdf:type owl:Class ;
    rdfs:subClassOf bfo:MaterialEntity ;
    skos:definition "A CriticalRawMaterial is a MaterialEntity that is essential for technological applications but faces a high risk of supply disruption." ;
    rdfs:comment "Raw materials vital for technology with a high risk of supply shortage." .

ex:CompositeWaste rdf:type owl:Class ;
    rdfs:subClassOf bfo:MaterialEntity ;
    skos:definition "A CompositeWaste is a MaterialEntity that consists of discarded materials made from a combination of different components, such as those found in wind turbine blades." ;
    rdfs:comment "Waste material derived from composite structures, particularly wind turbine blades." .

ex:RecyclingInfrastructure rdf:type owl:Class ;
    rdfs:subClassOf bfo:MaterialEntity ;
    skos:definition "A RecyclingInfrastructure is a MaterialEntity that comprises the facilities, equipment, and systems necessary for processing waste materials for reuse or recovery." ;
    rdfs:comment "The physical setup and resources required for recycling processes." .

ex:PermittingProcess rdf:type owl:Class ;
    rdfs:subClassOf bfo:Process ;
    skos:definition "A PermittingProcess is a Process that involves the procedures and requirements for obtaining official authorization to undertake a specific activity or project, such as constructing a wind farm." ;
    rdfs:comment "The sequence of steps and regulations involved in obtaining official permission for a project." .

ex:OneStopShopPermittingModel rdf:type owl:Class ;
    rdfs:subClassOf bfo:Process ;
    skos:definition "A OneStopShopPermittingModel is a Process that centralizes all necessary administrative and regulatory steps for project permitting through a single point of contact or agency." ;
    rdfs:comment "An administrative model that consolidates all permitting procedures into a single entity." .

ex:LowFrequencyNoise rdf:type owl:Class ;
    rdfs:subClassOf bfo:Quality ;
    skos:definition "A LowFrequencyNoise is a Quality that refers to sound waves with frequencies typically below 200 Hz, which can be emitted by wind turbines." ;
    rdfs:comment "Sound characterized by low frequencies, often associated with wind turbine operation." .

ex:PsychoMedicalEffect rdf:type owl:Class ;
    rdfs:subClassOf bfo:Quality ;
    skos:definition "A PsychoMedicalEffect is a Quality that describes the psychological or medical symptoms experienced by individuals due to exposure to certain stimuli, such as noise." ;
    rdfs:comment "Adverse psychological or physiological responses to environmental factors." .

ex:DirectPhysicalEffect rdf:type owl:Class ;
    rdfs:subClassOf bfo:Quality ;
    skos:definition "A DirectPhysicalEffect is a Quality that denotes a physiological impact on the human body directly caused by an external factor, independent of psychological perception." ;
    rdfs:comment "A tangible, measurable physical impact on the body." .

ex:ResidentAttitude rdf:type owl:Class ;
    rdfs:subClassOf bfo:Quality ;
    skos:definition "A ResidentAttitude is a Quality that represents the disposition, feelings, or opinions held by individuals living in proximity to wind turbines regarding their presence and impact." ;
    rdfs:comment "The perspective or stance of local residents towards wind energy installations." .

ex:ExposureSymptom rdf:type owl:Class ;
    rdfs:subClassOf bfo:Quality ;
    skos:definition "An ExposureSymptom is a Quality that describes a physical or psychological manifestation reported by individuals due to exposure to a specific factor, such as infrasound and low frequency noise from wind turbines." ;
    rdfs:comment "Represents reported symptoms resulting from exposure to environmental factors like wind turbine noise." .

ex:LowFrequencyNoiseEffect rdf:type owl:Class ;
    rdfs:subClassOf bfo:Quality ;
    skos:definition "A LowFrequencyNoiseEffect is a Quality that describes a potential impact on human health or perception resulting from exposure to low-frequency noise, particularly from wind turbines, for which scientific understanding may be limited." ;
    rdfs:comment "Describes the potential health or perceptual effects associated with low-frequency noise from wind turbines." .

ex:InfrasoundEffect rdf:type owl:Class ;
    rdfs:subClassOf bfo:Quality ;
    skos:definition "An InfrasoundEffect is a Quality that describes a potential impact on human health or perception resulting from exposure to infrasound, particularly from wind turbines, for which scientific understanding may be limited." ;
    rdfs:comment "Describes the potential health or perceptual effects associated with infrasound from wind turbines." .

ex:WindTurbineNoisePerception rdf:type owl:Class ;
    rdfs:subClassOf bfo:Quality ;
    skos:definition "A WindTurbineNoisePerception is a Quality that represents how individuals perceive and interpret noise generated by wind turbines, which can be influenced by various factors beyond objective sound levels." ;
    rdfs:comment "Refers to the subjective interpretation and experience of noise from wind turbines." .

ex:SleepDisturbance rdf:type owl:Class ;
    rdfs:subClassOf bfo:Quality ;
    skos:definition "A SleepDisturbance is a Quality that describes an alteration or disruption in normal sleep patterns, which can be self-reported and potentially associated with environmental factors like noise." ;
    rdfs:comment "Represents a disruption in normal sleep patterns, potentially linked to environmental factors." .

ex:ElectromagneticFieldExposure rdf:type owl:Class ;
    rdfs:subClassOf bfo:Quality ;
    skos:definition "An ElectromagneticFieldExposure is a Quality that quantifies the level of electromagnetic fields to which individuals or the environment are subjected, particularly in the context of wind turbine operation." ;
    rdfs:comment "Quantifies exposure to electromagnetic fields generated by wind turbines." .

ex:ShadowFlickerImpact rdf:type owl:Class ;
    rdfs:subClassOf bfo:Quality ;
    skos:definition "A ShadowFlickerImpact is a Quality that describes the effect on residents caused by the periodic casting of shadows from wind turbine rotors onto surrounding buildings during sunny intervals." ;
    rdfs:comment "Describes the impact on residents due to the periodic shadows cast by wind turbine rotors." .

ex:ShadowFlickerProtectionSystem rdf:type owl:Class ;
    rdfs:subClassOf bfo:Entity ;
    skos:definition "A ShadowFlickerProtectionSystem is a WindEnergyTechnology that is integrated into the control system of a wind turbine to prevent or mitigate the impact of shadow flicker on surrounding areas." ;
    rdfs:comment "A system used in wind turbines to prevent shadow flicker impacts on residents." .

ex:PublicAcceptanceDriver rdf:type owl:Class ;
    rdfs:subClassOf bfo:Quality ;
    skos:definition "A PublicAcceptanceDriver is a Quality that represents a factor influencing the level of public acceptance or opposition towards wind energy projects." ;
    rdfs:comment "Factors that influence public acceptance or opposition to wind energy projects." .

ex:RepoweringDriver rdf:type owl:Class ;
    rdfs:subClassOf bfo:Quality ;
    skos:definition "A RepoweringDriver is a Quality that represents a factor motivating or influencing decisions related to the repowering of existing wind energy projects." ;
    rdfs:comment "Factors that drive decisions for wind energy repowering projects." .

ex:LandscapeImpact rdf:type owl:Class ;
    rdfs:subClassOf bfo:Quality ;
    skos:definition "A LandscapeImpact is a Quality that describes the effect of wind energy projects, particularly repowering, on the visual and aesthetic characteristics of the surrounding landscape." ;
    rdfs:comment "The effect of wind energy projects on the visual landscape." .

ex:POTENCIAModel rdf:type owl:Class ;
    rdfs:subClassOf bfo:InformationContentEntity ;
    skos:definition "A POTENCIAModel is an InformationContentEntity that is an energy system simulation model designed to compare alternative pathways for the EU energy system, covering energy supply and all energy demand sectors." ;
    rdfs:comment "The Policy Oriented Tool for Energy and Climate Change Impact Assessment (POTEnCIA) model used for EU energy system analysis." .

ex:EnergySystemSimulationModel rdf:type owl:Class ;
    rdfs:subClassOf bfo:InformationContentEntity ;
    skos:definition "An EnergySystemSimulationModel is an InformationContentEntity that is a computational model designed to simulate the behavior and interactions of energy systems under various conditions and policies." ;
    rdfs:comment "A model used to simulate energy systems and their responses to different policies and conditions." .

ex:DecisionMakingSimulation rdf:type owl:Class ;
    rdfs:subClassOf bfo:Process ;
    skos:definition "A DecisionMakingSimulation is a Process that models and replicates the process of decision-making, particularly by energy users or agents, under various constraints and policy regimes." ;
    rdfs:comment "Simulates the process of decision-making in energy systems, considering imperfect foresight and user behavior." .

ex:EnergyMarketOperationSimulation rdf:type owl:Class ;
    rdfs:subClassOf bfo:Process ;
    skos:definition "An EnergyMarketOperationSimulation is a Process that models the economically-driven operation of energy markets, including supply-demand interactions and the behavior of representative agents seeking to optimize their outcomes." ;
    rdfs:comment "Models the operation of energy markets based on economic principles and agent behavior." .

ex:EnergySystemHistoricalDataCalibration rdf:type owl:Class ;
    rdfs:subClassOf bfo:Process ;
    skos:definition "An EnergySystemHistoricalDataCalibration is a Process that involves adjusting the parameters and initial conditions of an energy system model using historical data to ensure accurate representation and forecasting." ;
    rdfs:comment "The process of calibrating energy system models using historical data for accurate initial conditions." .

ex:POTENCIACETOScenario rdf:type owl:Class ;
    rdfs:subClassOf bfo:InformationContentEntity ;
    skos:definition "A POTENCIACETOScenario is an InformationContentEntity that represents a climate-neutrality scenario for the EU energy system, aligning with the European Green Deal's GHG reduction objectives and incorporating policy instruments influencing technology uptake." ;
    rdfs:comment "Represents the POTEnCIA CETO 2024 scenario for EU energy system modeling." .

ex:POLESJRCModel rdf:type owl:Class ;
    rdfs:subClassOf bfo:InformationContentEntity ;
    rdfs:subClassOf ex:EnergySystemSimulationModel ;
    skos:definition "A POLESJRCModel is an EnergySystemSimulationModel that is a global energy model used to evaluate the evolution of energy demand and supply, covering primary supply, transformation, and final sectoral demand, with endogenous calculation of international markets and prices." ;
    rdfs:comment "The Prospective Outlook for the Long-term Energy System (POLES-JRC) global energy model." .

ex:POLESJRCModelPowerSystem rdf:type owl:Class ;
    rdfs:subClassOf bfo:InformationContentEntity ;
    skos:definition "A POLESJRCModelPowerSystem is an InformationContentEntity that describes the power generation technologies, electricity demand, and power system operation and planning within the POLES-JRC model." ;
    rdfs:comment "Details the power system component of the POLES-JRC model." .

ex:POLESJRCModelHydrogenProduction rdf:type owl:Class ;
    rdfs:subClassOf bfo:InformationContentEntity ;
    skos:definition "A POLESJRCModelHydrogenProduction is an InformationContentEntity that outlines the various hydrogen production routes considered within the POLES-JRC model, including electrolysis, steam reforming, and gasification." ;
    rdfs:comment "Describes the hydrogen production routes modeled in POLES-JRC." .

ex:POLESJRCModelBioenergy rdf:type owl:Class ;
    rdfs:subClassOf bfo:InformationContentEntity ;
    skos:definition "A POLESJRCModelBioenergy is an InformationContentEntity that details how bioenergy demand and supply are modeled in the POLES-JRC model, often through soft-coupling with other models like GLOBIOM-G4M." ;
    rdfs:comment "Represents the bioenergy modeling approach within the POLES-JRC model." .

ex:POLESJRCModelCCUS rdf:type owl:Class ;
    rdfs:subClassOf bfo:InformationContentEntity ;
    skos:definition "A POLESJRCModelCCUS is an InformationContentEntity that specifies the applications of Carbon Capture, Utilization, and Storage (CCUS) technologies within the POLES-JRC model across power generation, hydrogen production, and industrial sectors." ;
    rdfs:comment "Details the integration of CCUS technologies in the POLES-JRC model." .

ex:TechnologyLearningInPOLESJRC rdf:type owl:Class ;
    rdfs:subClassOf bfo:Process ;
    skos:definition "A TechnologyLearningInPOLESJRC is a Process that describes the enhancement of the POLES-JRC model to capture technology learning effects, particularly for clean energy technologies, through methods like learning-by-doing." ;
    rdfs:comment "The process of incorporating technology learning into the POLES-JRC model." .

ex:LearningByDoingApproach rdf:type owl:Class ;
    rdfs:subClassOf bfo:Process ;
    skos:definition "A LearningByDoingApproach is a Process that models the reduction in cost or improvement in efficiency of a technology as its cumulative capacity or production increases." ;
    rdfs:comment "Represents the concept of cost reduction or efficiency improvement in technologies due to accumulated experience and production." .

ex:LearningRate rdf:type owl:Class ;
    rdfs:subClassOf bfo:Quality ;
    skos:definition "A LearningRate is a Quality that quantifies the percentage change in the cost of an energy technology based on a doubling of its cumulative capacity or production." ;
    rdfs:comment "A parameter within learning-by-doing models that indicates the rate of cost reduction with increased experience." .

ex:FloorCost rdf:type owl:Class ;
    rdfs:subClassOf bfo:Quality ;
    skos:definition "A FloorCost is a Quality that specifies the minimum achievable investment cost for a component or technology, acting as a limit for cost reduction through learning." ;
    rdfs:comment "The minimum cost threshold for a component or technology, below which further cost reductions from learning are not expected." .

ex:ComponentLevelLearning rdf:type owl:Class ;
    rdfs:subClassOf bfo:Process ;
    rdfs:subClassOf ex:LearningByDoingApproach ;
    skos:definition "A ComponentLevelLearning is a LearningByDoingApproach that applies learning-by-doing principles to individual components of technologies, allowing for the modeling of spillover effects across different technologies and sectors." ;
    rdfs:comment "Applies learning-by-doing principles at the component level to capture cross-technology and cross-sectoral spillover effects." .

ex:GlobalCarbonPriceScenario rdf:type owl:Class ;
    rdfs:subClassOf bfo:InformationContentEntity ;
    skos:definition "A GlobalCarbonPriceScenario is an InformationContentEntity that defines a pathway for limiting global temperature increase by implementing a single global carbon price across all regions, considering enacted climate policies but not long-term pledges." ;
    rdfs:comment "A scenario driven by a global carbon price trajectory to limit global warming, incorporating enacted policies but not future pledges." .

ex:DecarbonisationScenario rdf:type owl:Class ;
    rdfs:subClassOf bfo:InformationContentEntity ;
    skos:definition "A DecarbonisationScenario is an InformationContentEntity that outlines a trajectory for achieving net greenhouse gas emission reductions aligned with specific climate laws and considering sector-specific legislation." ;
    rdfs:comment "A scenario focused on achieving net greenhouse gas emission reductions aligned with climate law objectives and sector-specific legislation." .

ex:EnergySystemScenario rdf:type owl:Class ;
    rdfs:subClassOf bfo:InformationContentEntity ;
    skos:definition "An EnergySystemScenario is an InformationContentEntity that represents a simulation or projection of the future energy system, considering various techno-economic assumptions, fuel costs, and policy incentives." ;
    rdfs:comment "A projection or simulation of the future energy system under specific assumptions and policy frameworks." .

ex:TechnologyLearningEnhancement rdf:type owl:Class ;
    rdfs:subClassOf bfo:Process ;
    skos:definition "A TechnologyLearningEnhancement is a Process that involves improving energy system models to better capture the effects of endogenous learning in clean energy technologies." ;
    rdfs:comment "The process of enhancing energy system models to better represent endogenous learning effects in clean energy technologies." .

ex:TechnoEconomicParameterUpdate rdf:type owl:Class ;
    rdfs:subClassOf bfo:Process ;
    skos:definition "A TechnoEconomicParameterUpdate is a Process that involves revising and updating the techno-economic parameters used in energy system models, often based on expert knowledge and recent data." ;
    rdfs:comment "The process of revising and updating techno-economic parameters within energy system models." .

ex:HorizonEuropeRAndIProject rdf:type owl:Class ;
    rdfs:subClassOf bfo:InformationContentEntity ;
    skos:definition "A HorizonEuropeRAndIProject is a WindEnergyResearchProject that is funded under the Horizon Europe programme and focuses on research and innovation within the wind energy sector." ;
    rdfs:comment "A research and innovation project funded by the Horizon Europe programme related to wind energy." .

ex:FloatingOffshoreWindProjectHorizonEurope rdf:type owl:Class ;
    rdfs:subClassOf bfo:Entity ;
    skos:definition "A FloatingOffshoreWindProjectHorizonEurope is a HorizonEuropeRAndIProject that specifically focuses on the development, demonstration, or industrialization of floating offshore wind technologies." ;
    rdfs:comment "A Horizon Europe funded project focused on floating offshore wind technology." .

ex:WindEnergySocialEngagementProject rdf:type owl:Class ;
    rdfs:subClassOf bfo:Entity ;
    skos:definition "A WindEnergySocialEngagementProject is a HorizonEuropeRAndIProject that addresses social aspects, acceptance, or engagement related to wind energy projects." ;
    rdfs:comment "A Horizon Europe funded project focused on social engagement aspects of wind energy." .

ex:WindEnergyResourceAssessmentProject rdf:type owl:Class ;
    rdfs:subClassOf bfo:Entity ;
    skos:definition "A WindEnergyResourceAssessmentProject is a HorizonEuropeRAndIProject that focuses on assessing and understanding the resources available for wind energy generation." ;
    rdfs:comment "A Horizon Europe funded project focused on assessing wind energy resources." .

ex:WindEnergyEnvironmentalImpactProject rdf:type owl:Class ;
    rdfs:subClassOf bfo:Entity ;
    skos:definition "A WindEnergyEnvironmentalImpactProject is a HorizonEuropeRAndIProject that investigates the environmental impacts associated with wind energy technologies and projects." ;
    rdfs:comment "A Horizon Europe funded project focused on the environmental impacts of wind energy." .

ex:WindEnergyNewTurbineMaterialsProject rdf:type owl:Class ;
    rdfs:subClassOf bfo:Entity ;
    skos:definition "A WindEnergyNewTurbineMaterialsProject is a HorizonEuropeRAndIProject that focuses on the development and application of new materials for wind turbine components." ;
    rdfs:comment "A Horizon Europe funded project focused on new materials for wind turbines." .

ex:WindEnergyMaintenanceProject rdf:type owl:Class ;
    rdfs:subClassOf bfo:Entity ;
    skos:definition "A WindEnergyMaintenanceProject is a HorizonEuropeRAndIProject that focuses on improving maintenance strategies, condition monitoring systems, or related technologies for wind energy systems." ;
    rdfs:comment "A Horizon Europe funded project focused on maintenance and condition monitoring for wind energy systems." .

ex:WindEnergyGridIntegrationProjectHorizonEurope rdf:type owl:Class ;
    rdfs:subClassOf bfo:Entity ;
    skos:definition "A WindEnergyGridIntegrationProjectHorizonEurope is a HorizonEuropeRAndIProject that focuses on enhancing the integration of wind energy into electrical grids." ;
    rdfs:comment "A Horizon Europe funded project focused on grid integration of wind energy." .

ex:http://example.org/BLOW rdf:type owl:Class ;
    rdfs:subClassOf bfo:Entity ;
    rdfs:subClassOf ex:http://example.org/FloatingOffshoreWindProject ;
    skos:definition "A project focused on developing and deploying floating offshore wind technologies, with a start date of January 1, 2023." ;
    rdfs:comment "This project is a specific instance of a floating offshore wind project." .

ex:http://example.org/ICONIC rdf:type owl:Class ;
    rdfs:subClassOf bfo:Entity ;
    rdfs:subClassOf ex:http://example.org/WindEnergyNewTurbineMaterialsProject ;
    skos:definition "A project focused on the development and application of new materials for wind turbine components, with a start date of December 1, 2023." ;
    rdfs:comment "This project is a specific instance of a wind energy new turbine materials project." .

ex:http://example.org/PhyDAWN rdf:type owl:Class ;
    rdfs:subClassOf bfo:Entity ;
    rdfs:subClassOf ex:http://example.org/WindEnergyGridIntegrationProjectHorizonEurope ;
    skos:definition "A project focused on enhancing the integration of wind energy into electrical grids, with a start date of July 1, 2023." ;
    rdfs:comment "This project is a specific instance of a wind energy grid integration project." .

ex:http://example.org/Blades2Build rdf:type owl:Class ;
    rdfs:subClassOf bfo:Entity ;
    rdfs:subClassOf ex:http://example.org/BladeRecyclingProject ;
    skos:definition "A project focused on developing and implementing recycling solutions for wind turbine blades, with a start date of January 1, 2023." ;
    rdfs:comment "This project is a specific instance of a blade recycling project." .

ex:http://example.org/EoLO-HUBs rdf:type owl:Class ;
    rdfs:subClassOf bfo:Entity ;
    rdfs:subClassOf ex:http://example.org/RecyclingCircularityProject ;
    skos:definition "A project focused on recycling and promoting circular economy principles within the wind energy sector, particularly concerning end-of-life components, with a start date of January 1, 2023." ;
    rdfs:comment "This project is a specific instance of a recycling and circularity project." .

ex:http://example.org/OCEANBATTERY rdf:type owl:Class ;
    rdfs:subClassOf bfo:Entity ;
    rdfs:subClassOf ex:http://example.org/GridIntegrationProjectHorizonEurope ;
    skos:definition "A project focused on improving the integration of wind energy into existing power grids, with a start date of July 1, 2023." ;
    rdfs:comment "This project is a specific instance of a grid integration project." .

ex:http://example.org/CleanS_tack rdf:type owl:Class ;
    rdfs:subClassOf bfo:Entity ;
    rdfs:subClassOf ex:http://example.org/GridIntegrationProjectHorizonEurope ;
    skos:definition "A project focused on enhancing the integration of wind energy into electrical grids, with a start date of February 1, 2023." ;
    rdfs:comment "This project is a specific instance of a grid integration project." .

# ===== Properties =====
ex:hasTitle rdf:type owl:DatatypeProperty ;
    rdfs:domain ex:Report ;
    rdfs:range xsd:string ;
    rdfs:comment "The title of the report" .

ex:writtenBy rdf:type owl:DatatypeProperty ;
    rdfs:domain ex:Report ;
    rdfs:range xsd:string ;
    rdfs:comment "The authors of the report" .

ex:publishedBy rdf:type owl:DatatypeProperty ;
    rdfs:domain ex:Report ;
    rdfs:range xsd:string ;
    rdfs:comment "The organization that published this report" .

ex:mainFocus rdf:type owl:DatatypeProperty ;
    rdfs:domain ex:TechnologyDevelopmentStatusReport ;
    rdfs:range xsd:string ;
    rdfs:comment "What the main focus of the report is" .

ex:publishedInYear rdf:type owl:DatatypeProperty ;
    rdfs:domain ex:Report ;
    rdfs:range xsd:integer ;
    rdfs:comment "The year in which the report was published" .

ex:discussesEnergyType rdf:type owl:ObjectProperty ;
    rdfs:domain ex:TechnologyDevelopmentStatusReport ;
    rdfs:range ex:WindEnergyTechnology ;
    rdfs:comment "What type of energy does the report mainly discuss" .

ex:methodologyUsed rdf:type owl:DatatypeProperty ;
    rdfs:domain ex:Report ;
    rdfs:range xsd:string ;
    rdfs:comment "The methodology used in this report" .

ex:numCountriesCovered rdf:type owl:DatatypeProperty ;
    rdfs:domain ex:TechnologyDevelopmentStatusReport ;
    rdfs:range xsd:integer ;
    rdfs:comment "How many countries are covered by the EU 27 deployment section" .

ex:mainObjectiveOfCETO rdf:type owl:DatatypeProperty ;
    rdfs:domain ex:Report ;
    rdfs:range xsd:string ;
    rdfs:comment "The main objectives of the Clean Energy Technology Observatory (CETO)" .

ex:bodiesInvolvedInCETO rdf:type owl:DatatypeProperty ;
    rdfs:domain ex:Report ;
    rdfs:range xsd:string ;
    rdfs:comment "European Commission bodies involved in running and supporting CETO" .

ex:colleaguesContributedToCETO rdf:type owl:DatatypeProperty ;
    rdfs:domain ex:Report ;
    rdfs:range xsd:string ;
    rdfs:comment "Colleagues who contributed to the review and coordination of the CETO project" .

ex:privateRDInvestmentPercentage rdf:type owl:DatatypeProperty ;
    rdfs:domain ex:Report ;
    rdfs:range xsd:decimal ;
    rdfs:comment "The percentage of total private R&D funding invested by the EU from 2010 to 2020." .

ex:floatingOffshoreWindSubstructuresUsed rdf:type owl:DatatypeProperty ;
    rdfs:domain ex:FloatingOffshoreWindSubstructure ;
    rdfs:range xsd:string ;
    rdfs:comment "The substructures used in floating offshore wind technology." .

ex:preCommercialFloatingOffshoreWindDesigns rdf:type owl:DatatypeProperty ;
    rdfs:domain ex:PreCommercialFloatingOffshoreWindDesign ;
    rdfs:range xsd:string ;
    rdfs:comment "The designs of pre-commercial floating offshore wind technology that have been deployed." .

ex:technologyReadinessLevelAssignedTo rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AirborneWindEnergySystem ;
    rdfs:range ex:TechnologyReadinessLevel ;
    rdfs:comment "Assigns the technology readiness level (TRL) to airborne wind energy systems." .

ex:currentTRLForFloatingOffshoreWindTechnologies rdf:type owl:ObjectProperty ;
    rdfs:domain ex:FloatingOffshoreWindSubstructure ;
    rdfs:range ex:TechnologyReadinessLevel ;
    rdfs:comment "Provides the current TRL for floating offshore wind technologies such as spar-buoy and semi-submersible designs." .

ex:efficiencyComparisonVAWTsToHAWTs rdf:type owl:DatatypeProperty ;
    rdfs:domain ex:VerticalAxisWindTurbine ;
    rdfs:range xsd:string ;
    rdfs:comment "Compares the efficiency of vertical axis wind turbines (VAWTs) to conventional horizontal axis wind turbines (HAWTs)." .

ex:hasPublicRDInvestment rdf:type owl:DatatypeProperty ;
    rdfs:domain ex:WindEnergyTechnology ;
    rdfs:range xsd:integer ;
    rdfs:comment "The amount of public R&D investment in wind energy in a given year, in millions of EUR." .

ex:hasPrivateRDInvestment rdf:type owl:DatatypeProperty ;
    rdfs:domain ex:WindEnergyTechnology ;
    rdfs:range xsd:integer ;
    rdfs:comment "The amount of private R&D investment in wind energy in a given year, in millions of EUR." .

ex:hasPublicRDInvestmentShare rdf:type owl:DatatypeProperty ;
    rdfs:domain ex:WindEnergyTechnology ;
    rdfs:range xsd:decimal ;
    rdfs:comment "The share of public R&D investment in wind energy as a percentage of total public investment." .

ex:hasPrivateRDInvestmentShare rdf:type owl:DatatypeProperty ;
    rdfs:domain ex:WindEnergyTechnology ;
    rdfs:range xsd:decimal ;
    rdfs:comment "The share of private R&D investment in wind energy as a percentage of total private investment." .

ex:hasVCPEInvestment rdf:type owl:DatatypeProperty ;
    rdfs:domain ex:WindEnergyTechnology ;
    rdfs:range xsd:integer ;
    rdfs:comment "The amount of venture capital and private equity investment in wind energy in a given year, in millions of EUR." .

ex:leadsInPublicRDInvestment rdf:type owl:DatatypeProperty ;
    rdfs:domain ex:WindEnergyTechnology ;
    rdfs:range xsd:string ;
    rdfs:comment "Indicates which entity leads in public R&D investment in wind energy." .

ex:leadsInPrivateRDInvestment rdf:type owl:DatatypeProperty ;
    rdfs:domain ex:WindEnergyTechnology ;
    rdfs:range xsd:string ;
    rdfs:comment "Indicates which entity leads in private R&D investment in wind energy." .

ex:hasOriginCountry rdf:type owl:DatatypeProperty ;
    rdfs:domain ex:WindEnergyTechnology ;
    rdfs:range xsd:string ;
    rdfs:comment "The country of origin for a company or entity involved in wind energy R&D investment." .

ex:hasRDInvestmentPriority rdf:type owl:DatatypeProperty ;
    rdfs:domain ex:WindEnergyTechnology ;
    rdfs:range xsd:string ;
    rdfs:comment "The R&D priority for which investment is allocated in wind energy." .

ex:hasBeneficiaryCountryForVCPEInvestment rdf:type owl:DatatypeProperty ;
    rdfs:domain ex:WindEnergyInvestment ;
    rdfs:range xsd:string ;
    rdfs:comment "Identifies a country that is a beneficiary of venture capital and private equity investment in the wind energy sector." .

ex:hasInvestmentDealStage rdf:type owl:ObjectProperty ;
    rdfs:domain ex:WindEnergyInvestment ;
    rdfs:range ex:InvestmentDealStage ;
    rdfs:comment "Categorizes the investment deal stage (e.g., early-stage, later-stage) for venture capital and private equity investments in the wind energy sector." .

ex:hasInvestmentPeriod rdf:type owl:DatatypeProperty ;
    rdfs:domain ex:WindEnergyInvestment ;
    rdfs:range xsd:string ;
    rdfs:comment "Specifies the time period for which venture capital and private equity investment data in the wind energy sector is considered." .

ex:hasInvestmentShare rdf:type owl:DatatypeProperty ;
    rdfs:domain ex:WindEnergyInvestment ;
    rdfs:range xsd:decimal ;
    rdfs:comment "Represents the share of investment deals in the wind energy sector for a specific region or entity." .

ex:hasCooperativePatentClassificationCode rdf:type owl:ObjectProperty ;
    rdfs:domain ex:WindEnergyInvention ;
    rdfs:range ex:CooperativePatentClassificationCode ;
    rdfs:comment "Associates a wind energy invention with a Cooperative Patent Classification code used for evaluating patenting activity." .

ex:hasInternationalInventionShare rdf:type owl:DatatypeProperty ;
    rdfs:domain ex:WindEnergyInvention ;
    rdfs:range xsd:decimal ;
    rdfs:comment "Indicates the percentage of wind energy inventions that are international for a given country or region." .

ex:hasHighValueInventionShare rdf:type owl:DatatypeProperty ;
    rdfs:domain ex:WindEnergyInvention ;
    rdfs:range xsd:decimal ;
    rdfs:comment "Represents the percentage of wind energy inventions that are considered high-value for a given country or region." .

ex:hasNumberOfInventions rdf:type owl:DatatypeProperty ;
    rdfs:domain ex:WindEnergyInvention ;
    rdfs:range xsd:integer ;
    rdfs:comment "The total number of wind energy inventions, represented by patent families, for a specific entity or period." .

ex:hasPublicationYear rdf:type owl:DatatypeProperty ;
    rdfs:domain ex:WindEnergyPublication ;
    rdfs:range xsd:integer ;
    rdfs:comment "The year in which a wind energy publication was published." .

ex:hasPublicationCount rdf:type owl:DatatypeProperty ;
    rdfs:domain ex:WindEnergyPublication ;
    rdfs:range xsd:integer ;
    rdfs:comment "The number of peer-reviewed articles published in the wind energy sector for a given year or region." .

ex:isHighlyCited rdf:type owl:DatatypeProperty ;
    rdfs:domain ex:WindEnergyPublication ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether a wind energy publication belongs to the top 10% most cited papers within its field and year." .

ex:hasPOTEnCIACentralScenarioReport rdf:type owl:DatatypeProperty ;
    rdfs:domain ex:Report ;
    rdfs:range xsd:string ;
    rdfs:comment "The property to identify the report presenting the POTEnCIA Central Scenario for EU energy outlook to 2050." .

ex:publishedByOrganization rdf:type owl:DatatypeProperty ;
    rdfs:domain ex:Report ;
    rdfs:range xsd:string ;
    rdfs:comment "The property to identify the organization that published a specific report." .

ex:hasOffshoreWindCapacityAddition rdf:type owl:ObjectProperty ;
    rdfs:domain ex:Report ;
    rdfs:range ex:OffshoreWindCapacityAddition ;
    rdfs:comment "Relates a report to the process of offshore wind capacity addition it discusses." .

ex:hasOnshoreWindCapacityAddition rdf:type owl:ObjectProperty ;
    rdfs:domain ex:Report ;
    rdfs:range ex:OnshoreWindCapacityAddition ;
    rdfs:comment "Relates a report to the process of onshore wind capacity addition it discusses." .

ex:hasOffshoreWindInstalledCapacity rdf:type owl:ObjectProperty ;
