@prefix ex: <http://example.org/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix bfo: <http://purl.obolibrary.org/obo/BFO_> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# ===== OWL Classes (BFO-anchored) =====
ex:AminoAcid rdf:type owl:Class ;
    rdfs:subClassOf bfo:MaterialEntity ;
    skos:definition "A AminoAcid is a MaterialEntity that contains an amino group (NH2) and a carboxyl group (-COOH)." ;
    rdfs:comment "" .

ex:EssentialAminoAcid rdf:type owl:Class ;
    rdfs:subClassOf bfo:MaterialEntity ;
    skos:definition "An EssentialAminoAcid is a MaterialEntity that cannot be produced by the body and must be obtained through food." ;
    rdfs:comment "" .

ex:SemiEssentialAminoAcid rdf:type owl:Class ;
    rdfs:subClassOf bfo:MaterialEntity ;
    skos:definition "A SemiEssentialAminoAcid is a MaterialEntity that can be produced in the body but its production may not be sufficient." ;
    rdfs:comment "" .

ex:NonEssentialAminoAcid rdf:type owl:Class ;
    rdfs:subClassOf bfo:MaterialEntity ;
    skos:definition "A NonEssentialAminoAcid is a MaterialEntity that can be produced by the body and does not require supplementation through food." ;
    rdfs:comment "" .

ex:PurelyKetogenicAminoAcid rdf:type owl:Class ;
    rdfs:subClassOf bfo:MaterialEntity ;
    skos:definition "A PurelyKetogenicAminoAcid is a MaterialEntity that can be used to make fat and is transformed into ketone bodies during metabolism, specifically leucine and lysine." ;
    rdfs:comment "Introduces a new class for purely ketogenic amino acids." .

ex:KetogenicAndGlucogenicAminoAcid rdf:type owl:Class ;
    rdfs:subClassOf bfo:MaterialEntity ;
    skos:definition "A KetogenicAndGlucogenicAminoAcid is a MaterialEntity that can be used as both ketogenic and glucogenic during metabolism, specifically lysine, isoleucine, phenylalanine, tyrosine, and tryptophan." ;
    rdfs:comment "Introduces a new class for amino acids with dual metabolic fate." .

ex:PurelyGlucogenicAminoAcid rdf:type owl:Class ;
    rdfs:subClassOf bfo:MaterialEntity ;
    skos:definition "A PurelyGlucogenicAminoAcid is a MaterialEntity that can be used as a starting point for the production of glucose or glycogen and solely enters the glucogenic pathway, specifically 14 amino acids." ;
    rdfs:comment "Introduces a new class for purely glucogenic amino acids." .

ex:NonPolarAminoAcid rdf:type owl:Class ;
    rdfs:subClassOf bfo:MaterialEntity ;
    skos:definition "A NonPolarAminoAcid is a MaterialEntity that has no charge on the 'R' group and is also known as hydrophobic amino acids, specifically alanine, leucine, isoleucine, valine, methionine, phenylalanine, tryptophan, and proline." ;
    rdfs:comment "Introduces a new class for non-polar amino acids." .

ex:PolarAminoAcidWithNoChargeOnRGroup rdf:type owl:Class ;
    rdfs:subClassOf bfo:MaterialEntity ;
    skos:definition "A PolarAminoAcidWithNoChargeOnRGroup is a MaterialEntity that has an uncharged 'R' group but contributes to protein structure hydrogen bonding, specifically glycine, serine, threonine, cysteine, glutamine, asparagine, and tyrosine." ;
    rdfs:comment "Introduces a new class for polar amino acids with no charge on the R group." .

ex:PolarAminoAcidWithPositiveChargeOnRGroup rdf:type owl:Class ;
    rdfs:subClassOf bfo:MaterialEntity ;
    skos:definition "A PolarAminoAcidWithPositiveChargeOnRGroup is a MaterialEntity that has a positive 'R' group and contributes to the basic character of amino acids, specifically lysine, arginine, and histidine." ;
    rdfs:comment "Introduces a new class for polar amino acids with a positive charge on the R group." .

ex:PolarAminoAcidWithNegativeChargeOnRGroup rdf:type owl:Class ;
    rdfs:subClassOf bfo:MaterialEntity ;
    skos:definition "A PolarAminoAcidWithNegativeChargeOnRGroup is a MaterialEntity that has a negative 'R' group and contributes to the acidic character of amino acids, specifically aspartic acid and glutamic acid." ;
    rdfs:comment "Introduces a new class for polar amino acids with a negative charge on the R group." .

ex:HydrolysisProduct rdf:type owl:Class ;
    rdfs:subClassOf bfo:MaterialEntity ;
    skos:definition "A HydrolysisProduct is a MaterialEntity produced as a result of the hydrolysis reaction." ;
    rdfs:comment "This class covers products like glycine, alanine, serine, valine, methionine, glutamic acid, leucine, isoleucine, norleucine, and phenylalanine." .

ex:GabrielPhthalimideSynthesis rdf:type owl:Class ;
    rdfs:subClassOf bfo:Process ;
    skos:definition "A GabrielPhthalimideSynthesis is a Process involving the treatment of an alpha halogenated acid ester with potassium phthalimide to produce a substituted phthalimide." ;
    rdfs:comment "This class describes the method used for preparing amino acids like glycine." .

ex:WilsonDiseaseTreatment rdf:type owl:Class ;
    rdfs:subClassOf bfo:Process ;
    skos:definition "A WilsonDiseaseTreatment is a Process involving chelation therapy using D-Penicillamine to treat Wilson’s disease." ;
    rdfs:comment "This class describes the treatment method for Wilson's disease." .

# ===== Properties =====
ex:hasFunction rdf:type owl:DatatypeProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range xsd:string ;
    rdfs:comment "Describes the function of an amino acid" .

ex:isProducedInBody rdf:type owl:DatatypeProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether an amino acid is produced in the body or not" .

ex:requiresSupplementationThroughFood rdf:type owl:DatatypeProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates if an amino acid requires supplementation through food" .

ex:taste rdf:type owl:DatatypeProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range xsd:string ;
    rdfs:comment "Describes the taste of an amino acid (sweet, bitter, or tasteless)" .

ex:hasOpticalIsomer rdf:type owl:DatatypeProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates if an amino acid has optical isomers" .

ex:isZwitterion rdf:type owl:DatatypeProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates if an amino acid is a zwitterion" .

ex:hasIsomer rdf:type owl:DatatypeProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range xsd:string ;
    rdfs:comment "Describes the type of isomer (L or D) for an amino acid" .

ex:undergoesDecarboxylation rdf:type owl:DatatypeProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates if an amino acid undergoes decarboxylation" .

ex:formsSaltWithAlkali rdf:type owl:DatatypeProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates if an amino acid forms a salt with alkali" .

ex:formsEsterWithAlcohol rdf:type owl:DatatypeProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates if an amino acid forms an ester with alcohol" .

ex:reactsWithAmmonia rdf:type owl:DatatypeProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates if an amino acid reacts with ammonia to form amides" .

ex:formsSaltWithMineralAcid rdf:type owl:DatatypeProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates if an amino acid forms a salt with mineral acids" .

ex:reactsWithNinhydrin rdf:type owl:DatatypeProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates if an amino acid reacts with ninhydrin to form a color change" .

ex:requiresSupplementationThroughFoodForChildren rdf:type owl:DatatypeProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates if an amino acid requires supplementation through food specifically for children" .

ex:isProducedInBodyForAdults rdf:type owl:DatatypeProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates if an amino acid is produced in the body at a sufficient rate for adults" .

ex:hydrolysisProduct rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range ex:HydrolysisProduct ;
    rdfs:comment "Describes the product of hydrolysis for an amino acid." .

ex:methodForSynthesis rdf:type owl:ObjectProperty ;
    rdfs:domain ex:AminoAcid ;
    rdfs:range ex:GabrielPhthalimideSynthesis ;
    rdfs:comment "Indicates the method used to synthesize an amino acid." .

